<Project>
    <Sdk Name="Rocket.Surgery.Sdk" />
    <PropertyGroup>
        <!-- Warnings stay non-fatal on CI, as before the SDK (the SDK defaults this on); RS0017 still fails the build. -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <!-- No PublicAPI.*.txt tracking in this repository. -->
        <RocketSurgeryPublicApiAnalyzers>false</RocketSurgeryPublicApiAnalyzers>
        <Company>Rocket Surgeons Guild</Company>
        <Copyright>Copyright Rocket Surgeons Guild © $([System.DateTime]::Now.ToString('yyyy'))</Copyright>
        <Authors>David Driscoll,Rocket Surgeons Guild contributors</Authors>
        <PackageProjectUrl>https://rocketsurgeonsguild.github.io/</PackageProjectUrl>
        <PackageIcon>images/packageicon.png</PackageIcon>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <!-- Tags every LaunchPad package shares; each project appends its own with $(PackageTags);... -->
        <PackageTags>launchpad;rocket-surgery</PackageTags>
        <NukeTelemetryVersion>1</NukeTelemetryVersion>
        <!--        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>-->
        <!--        <WarningsNotAsErrors></WarningsNotAsErrors>-->

        <SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <!--
        The target frameworks of every project in src/, sample/ and test/, oldest first. No project file names a framework itself; each sets
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks> (the WebAssembly projects the -browser form, the few that build for
        one framework the newest or the oldest). The generators, analyzers, MSBuild task and SDK packages stay on netstandard2.0, which the compiler and
        MSBuild load. Adding a framework starts here: CONTRIBUTING.md ("Adding a target framework") lists everything else that changes.
    -->
    <PropertyGroup>
        <LaunchPadTargetFrameworks>net11.0</LaunchPadTargetFrameworks>
        <!-- The same frameworks for WebAssembly: net11.0-browser for net11.0. -->
        <LaunchPadBrowserTargetFrameworks>$(LaunchPadTargetFrameworks.Replace(';', '-browser;'))-browser</LaunchPadBrowserTargetFrameworks>
        <!-- The oldest of them, for a library every project must be able to reference that can only build for one: the API functional fixtures. -->
        <LaunchPadOldestTargetFramework>$([System.Text.RegularExpressions.Regex]::Match('$(LaunchPadTargetFrameworks)', '^\s*[^;\s]+').Value.Trim())</LaunchPadOldestTargetFramework>
        <!-- The newest of them, for a project that can only build for one: the SDK tests' host, which loads MSBuild from the SDK of its own version, and the native AOT check. -->
        <LaunchPadLatestTargetFramework>$([System.Text.RegularExpressions.Regex]::Match('$(LaunchPadTargetFrameworks)', '[^;\s]+(?=\s*$)').Value)</LaunchPadLatestTargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <None
            Include="$(MSBuildThisFileDirectory).temp/packageicon.png"
            Condition="Exists('$(MSBuildThisFileDirectory).temp/packageicon.png')"
            Pack="true"
            PackagePath="/images/"
            Visible="false"
        />
        <None Include="$(MSBuildThisFileDirectory)/LICENSE" Pack="true" PackagePath="/" Visible="false" />
        <None Include="$(MSBuildThisFileDirectory)/Readme.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>
    <ItemGroup>
        <ProjectCapability Include="DynamicDependentFile" />
        <ProjectCapability Include="DynamicFileNesting" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="System.Diagnostics.CodeAnalysis" />
        <Using Include="System.Diagnostics.CodeAnalysis.NotNullAttribute" Alias="NotNullAttribute" />
    </ItemGroup>
</Project>
