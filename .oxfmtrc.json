{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "tabWidth": 4,
  "singleQuote": true,
  "ignorePatterns": [
    "**/*.verified.*",
    "**/*.received.*",
    ".agents/",
    ".apm/",
    ".claude/",
    ".copilot/",
    ".squad/",
    ".github/agents/",
    ".github/instructions/",
    ".github/copilot-instructions.md",
    "AGENTS.md",
    "apm.yml",
    "apm.lock.yaml",
    "**/AnalyzerReleases.*.md",
    "README.md",
    "Readme.md",
    "docs/src/content/docs/api/",
    "**/*.min.css",
    "**/*.min.js"
  ],
  "overrides": [
    {
      "files": ["*.mdx"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
