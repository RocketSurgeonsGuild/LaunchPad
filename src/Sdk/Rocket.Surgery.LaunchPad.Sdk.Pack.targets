<Project>
    <!--
        Shared by the LaunchPad SDKs: Rocket.Surgery.LaunchPad.Sdk (src/Sdk), which chains Joinery.Dovetail.Sdk, and
        Rocket.Surgery.LaunchPad.Sdk.Console (src/Sdk.Console), which chains Joinery.Dovetail.Sdk.Console. Each sets LaunchPadChainedSdk
        to the Dovetail SDK it chains before importing this file.

        Writes Sdk/Packages.props into the package: LaunchPadVersion, the version of the SDK, which every LaunchPad package it adds to an
        application shares, LaunchPadDovetailSdkVersion, the version of the Dovetail SDK that Sdk/Sdk.props chains, which is the one
        Directory.Packages.props pins, and the version of Polyfill the detection adds before .NET 11, also pinned there. An application can
        set any of them first to choose another. As in Joinery.Dovetail.Sdk, the versions are only known when the SDK is packed, so the file
        is generated then rather than kept in the repository.

        Sdk/Rocket.Surgery.LaunchPad.Detection.targets, and the files it imports, decide which packages an application gets. A package
        added there is also packed by test/Sdk.Tests (PackedSdk.Projects) and sample/Sample.Sdk/build/pack.proj, so the tests and the
        sample can restore it.
    -->
    <Target Name="_LaunchPadGeneratePackagesProps" BeforeTargets="_GetPackageFiles;Pack">
        <ItemGroup>
            <_LaunchPadDovetailSdk Include="@(PackageVersion)" Condition="'%(Identity)' == '$(LaunchPadChainedSdk)'" />
            <_LaunchPadPolyfill Include="@(PackageVersion)" Condition="'%(Identity)' == 'Polyfill'" />
        </ItemGroup>
        <PropertyGroup>
            <_LaunchPadDovetailSdkVersion>@(_LaunchPadDovetailSdk->'%(Version)')</_LaunchPadDovetailSdkVersion>
            <_LaunchPadPolyfillVersion>@(_LaunchPadPolyfill->'%(Version)')</_LaunchPadPolyfillVersion>
            <_LaunchPadPackagesProps>$(IntermediateOutputPath)Packages.props</_LaunchPadPackagesProps>
        </PropertyGroup>
        <Error Condition="'$(_LaunchPadDovetailSdkVersion)' == ''" Text="Directory.Packages.props pins no version of $(LaunchPadChainedSdk), which $(PackageId) chains." />
        <Error Condition="'$(_LaunchPadPolyfillVersion)' == ''" Text="Directory.Packages.props pins no version of Polyfill, which $(PackageId) adds before .NET 11." />
        <ItemGroup>
            <!-- %24 is $ and %27 is ': the file reads the consumer's properties, which must not be expanded here -->
            <_LaunchPadPackagesPropsLine Include="&lt;Project&gt;" />
            <_LaunchPadPackagesPropsLine Include="&lt;!-- Generated when $(PackageId) is packed. Each version is only set when the application has not set it already. --&gt;" />
            <_LaunchPadPackagesPropsLine Include="&lt;PropertyGroup&gt;" />
            <_LaunchPadPackagesPropsLine
                Include="&lt;LaunchPadDovetailSdkVersion Condition=&quot;%27%24(LaunchPadDovetailSdkVersion)%27 == %27%27&quot;&gt;$(_LaunchPadDovetailSdkVersion)&lt;/LaunchPadDovetailSdkVersion&gt;"
            />
            <_LaunchPadPackagesPropsLine
                Include="&lt;LaunchPadVersion Condition=&quot;%27%24(LaunchPadVersion)%27 == %27%27&quot;&gt;$(PackageVersion)&lt;/LaunchPadVersion&gt;"
            />
            <_LaunchPadPackagesPropsLine
                Include="&lt;LaunchPadPolyfillVersion Condition=&quot;%27%24(LaunchPadPolyfillVersion)%27 == %27%27&quot;&gt;$(_LaunchPadPolyfillVersion)&lt;/LaunchPadPolyfillVersion&gt;"
            />
            <_LaunchPadPackagesPropsLine Include="&lt;/PropertyGroup&gt;" />
            <_LaunchPadPackagesPropsLine Include="&lt;/Project&gt;" />
        </ItemGroup>
        <WriteLinesToFile File="$(_LaunchPadPackagesProps)" Lines="@(_LaunchPadPackagesPropsLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <None Include="$(_LaunchPadPackagesProps)" Pack="true" PackagePath="Sdk" />
            <FileWrites Include="$(_LaunchPadPackagesProps)" />
        </ItemGroup>
    </Target>
</Project>
