<Project>
    <!--
        NetTopologySuite, imported by Rocket.Surgery.LaunchPad.Detection.targets. A project that references NetTopologySuite directly gets:
          - Rocket.Surgery.LaunchPad.Spatial, which also destructures the geometries in the Serilog logger Dovetail creates
          - Rocket.Surgery.LaunchPad.StrawberryShake.Spatial, when it also references a StrawberryShake client package
        LaunchPadEnableNetTopologySuite set to false opts a project out, the integration package included; LaunchPadEnableStrawberryShake
        set to false keeps the integration package out.
    -->
    <ItemGroup Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'NetTopologySuite')) == 'true'">
        <DovetailSdkImplicitPackageReference Include="Rocket.Surgery.LaunchPad.Spatial" Version="$(LaunchPadVersion)" />
        <DovetailSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.StrawberryShake.Spatial"
            Version="$(LaunchPadVersion)"
            Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'StrawberryShake')) == 'true'"
        />
    </ItemGroup>
</Project>
