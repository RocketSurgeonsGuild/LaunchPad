<Project>
    <!--
        ZeroAlloc, imported by Rocket.Surgery.LaunchPad.Detection.targets. A project that references ZeroAlloc.Validation directly (or
        ZeroAlloc.Mediator.Validation, which validates the mediator's requests with it) has no package of its own to add: ZeroAlloc's
        generators and Dovetail wire the mediator and the validators. It gets the integration package of each partner technology it has:
          - Rocket.Surgery.LaunchPad.ZeroAlloc.AspNetCore, when it is an ASP.NET Core application (the WebApplication host model)
          - Rocket.Surgery.LaunchPad.ZeroAlloc.Grpc, when it also references a gRPC server package
          - Rocket.Surgery.LaunchPad.ZeroAlloc.HotChocolate, when it also references HotChocolate
          - Rocket.Surgery.LaunchPad.ZeroAlloc.Blazor, when it is a Blazor WebAssembly application (the WebAssembly host model), or
            references Microsoft.AspNetCore.Components.Web. A Blazor Server application gets the components from the ASP.NET Core shared
            framework, which is no package reference, so it references Rocket.Surgery.LaunchPad.ZeroAlloc.Blazor itself.
        LaunchPadEnableZeroAlloc set to false opts a project out; opting the partner technology out keeps its integration package out.
    -->
    <ItemGroup Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'ZeroAlloc')) == 'true'">
        <DovetailSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.ZeroAlloc.AspNetCore"
            Version="$(LaunchPadVersion)"
            Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'AspNetCore')) == 'true'"
        />
        <DovetailSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.ZeroAlloc.Grpc"
            Version="$(LaunchPadVersion)"
            Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'Grpc')) == 'true'"
        />
        <DovetailSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.ZeroAlloc.HotChocolate"
            Version="$(LaunchPadVersion)"
            Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'HotChocolate')) == 'true'"
        />
        <DovetailSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.ZeroAlloc.Blazor"
            Version="$(LaunchPadVersion)"
            Condition="@(DovetailHost->AnyHaveMetadataValue('Identity', 'WebAssembly')) == 'true' or @(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.AspNetCore.Components.Web')) == 'true'"
        />
    </ItemGroup>
</Project>
