<Project>
    <!--
        NodaTime, imported by Rocket.Surgery.LaunchPad.Detection.targets. A project that references NodaTime directly, and every file-based
        app, gets:
          - Rocket.Surgery.LaunchPad.NodaTime, which also destructures the NodaTime types in the Serilog logger Dovetail creates
          - Rocket.Surgery.LaunchPad.NodaTime.HotChocolate, when it also references HotChocolate
          - Rocket.Surgery.LaunchPad.NodaTime.StrawberryShake, when it also references a StrawberryShake client package
        LaunchPadEnableNodaTime set to false opts a project out, the integration packages included; LaunchPadEnableHotChocolate or
        LaunchPadEnableStrawberryShake set to false keeps that integration package out.
    -->
    <ItemGroup Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'NodaTime')) == 'true'">
        <DovetailSdkImplicitPackageReference Include="Rocket.Surgery.LaunchPad.NodaTime" Version="$(LaunchPadVersion)" />
        <DovetailSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.NodaTime.HotChocolate"
            Version="$(LaunchPadVersion)"
            Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'HotChocolate')) == 'true'"
        />
        <DovetailSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.NodaTime.StrawberryShake"
            Version="$(LaunchPadVersion)"
            Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'StrawberryShake')) == 'true'"
        />
    </ItemGroup>
</Project>
