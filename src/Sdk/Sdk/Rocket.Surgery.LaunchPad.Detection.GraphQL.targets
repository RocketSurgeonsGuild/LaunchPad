<Project>
    <!--
        GraphQL, imported by Rocket.Surgery.LaunchPad.Detection.targets. A project that references them directly gets:
          - Rocket.Surgery.LaunchPad.HotChocolate, when it references HotChocolate (a GraphQL server)
          - Rocket.Surgery.LaunchPad.StrawberryShake, when it references a StrawberryShake client package (a GraphQL client)
        LaunchPadEnableHotChocolate and LaunchPadEnableStrawberryShake set to false opt a project out. The NodaTime, NetTopologySuite and
        FluentValidation integration packages of both are added by the files of those technologies.
    -->
    <ItemGroup>
        <DovetailSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.HotChocolate"
            Version="$(LaunchPadVersion)"
            Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'HotChocolate')) == 'true'"
        />
        <DovetailSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.StrawberryShake"
            Version="$(LaunchPadVersion)"
            Condition="@(_LaunchPadTechnology->AnyHaveMetadataValue('Identity', 'StrawberryShake')) == 'true'"
        />
    </ItemGroup>
</Project>
