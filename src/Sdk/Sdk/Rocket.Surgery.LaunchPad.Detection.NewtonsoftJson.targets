<Project>
    <!--
        Newtonsoft.Json, imported by Rocket.Surgery.LaunchPad.Detection.targets. A project that references Newtonsoft.Json directly gets:
          - Rocket.Surgery.LaunchPad.Foundation.NewtonsoftJson
        LaunchPadEnableNewtonsoftJson set to false opts a project out.

        The conditions are on the items: MSBuild evaluates every property before any item, so a property cannot read PackageReference.
    -->
    <PropertyGroup>
        <LaunchPadEnableNewtonsoftJson Condition="'$(LaunchPadEnableNewtonsoftJson)' == ''">true</LaunchPadEnableNewtonsoftJson>
    </PropertyGroup>
    <ItemGroup Condition="'$(LaunchPadEnableNewtonsoftJson)' != 'false'">
        <LaunchPadSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.Foundation.NewtonsoftJson"
            Version="$(LaunchPadFoundationNewtonsoftJsonVersion)"
            Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Newtonsoft.Json'))"
        />
        <LaunchPadSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.AspNetCore.NewtonsoftJson"
            Version="$(LaunchPadAspNetCoreNewtonsoftJsonVersion)"
            Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Newtonsoft.Json')) and @(FrameworkReference->AnyHaveMetadataValue('Identity', 'Microsoft.AspNetCore.App'))"
        />
        <LaunchPadSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.Mapping.NewtonsoftJson"
            Version="$(LaunchPadMappingNewtonsoftJsonVersion)"
            Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Newtonsoft.Json')) and @(PackageReference->AnyHaveMetadataValue('Identity', 'Riok.Mapperly'))"
        />
    </ItemGroup>
</Project>
