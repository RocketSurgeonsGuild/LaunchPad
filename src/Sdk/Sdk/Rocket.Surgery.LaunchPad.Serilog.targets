<Project>
    <!--
        LaunchPad's Serilog packages, imported by Rocket.Surgery.LaunchPad.Detection.targets before it turns the
        LaunchPadSdkImplicitPackageReference items into PackageReferences.

        A project that references Serilog directly (the same detection as Dovetail's DovetailEnableSerilog) gets each package whose partner
        it also has. LaunchPadEnableSerilog set to false opts it out of all of them; Dovetail's own Serilog support keeps its own switch. Only
        Serilog itself counts, as for Dovetail: LaunchPad's packages log through the logger Joinery.Dovetail.Serilog registers.
          - Rocket.Surgery.LaunchPad.Serilog.AspNetCore (request logging): an ASP.NET Core application, the WebApplication host model.
          - Rocket.Surgery.LaunchPad.NewtonsoftJson.Serilog (destructuring): a reference to Newtonsoft.Json.
          - Rocket.Surgery.LaunchPad.Spatial.Serilog (destructuring): a reference to NetTopologySuite.
        NodaTime's destructuring package, Rocket.Surgery.LaunchPad.NodaTime.Serilog, comes with NodaTime (Rocket.Surgery.LaunchPad.Detection.NodaTime.targets).
    -->
    <PropertyGroup>
        <LaunchPadEnableSerilog Condition="'$(LaunchPadEnableSerilog)' == ''">true</LaunchPadEnableSerilog>
    </PropertyGroup>
    <!-- An item list is only allowed in the condition of an item or an item group, not of a property. -->
    <ItemGroup Condition="'$(LaunchPadEnableSerilog)' != 'false' and @(PackageReference->AnyHaveMetadataValue('Identity', 'Serilog')) == 'true'">
        <LaunchPadSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.Serilog.AspNetCore"
            Version="$(LaunchPadVersion)"
            Condition="@(DovetailHost->AnyHaveMetadataValue('Identity', 'WebApplication')) == 'true'"
        />
        <LaunchPadSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.NewtonsoftJson.Serilog"
            Version="$(LaunchPadVersion)"
            Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Newtonsoft.Json')) == 'true'"
        />
        <LaunchPadSdkImplicitPackageReference
            Include="Rocket.Surgery.LaunchPad.Spatial.Serilog"
            Version="$(LaunchPadVersion)"
            Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'NetTopologySuite')) == 'true'"
        />
    </ItemGroup>
</Project>
