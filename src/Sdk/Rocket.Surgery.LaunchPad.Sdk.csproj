<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <PackageType>MSBuildSdk</PackageType>
        <NoBuildOutput>true</NoBuildOutput>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <ImplicitUsings>disable</ImplicitUsings>
        <PackageDescription>MSBuild SDK for LaunchPad: chains Joinery.Dovetail.Sdk and adds the LaunchPad packages for what an application is and references</PackageDescription>
        <PackageTags>$(PackageTags);sdk;msbuild</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Sdk/**" />
        <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />
        <Using Remove="**" />
    </ItemGroup>

    <!--
        Writes Sdk/Packages.props into the package: LaunchPadVersion, the version of the SDK, which every LaunchPad package it adds to an
        application shares, and the version of Joinery.Dovetail.Sdk that Sdk/Sdk.props chains, which is the one Directory.Packages.props
        pins. An application can set either first to choose another. As in Joinery.Dovetail.Sdk, the versions are only known when the SDK
        is packed, so the file is generated then rather than kept in the repository.

        Sdk/Rocket.Surgery.LaunchPad.Detection.targets, and the files it imports, decide which packages an application gets. A package
        added there is also packed by test/Sdk.Tests (PackedSdk.Projects) and sample/Sample.Sdk/build/pack.proj, so the tests and the
        sample can restore it.
    -->
    <Target Name="_LaunchPadGeneratePackagesProps" BeforeTargets="_GetPackageFiles;Pack">
        <ItemGroup>
            <_LaunchPadDovetailSdk Include="@(PackageVersion)" Condition="'%(Identity)' == 'Joinery.Dovetail.Sdk'" />
        </ItemGroup>
        <PropertyGroup>
            <_LaunchPadDovetailSdkVersion>@(_LaunchPadDovetailSdk->'%(Version)')</_LaunchPadDovetailSdkVersion>
            <_LaunchPadPackagesProps>$(IntermediateOutputPath)Packages.props</_LaunchPadPackagesProps>
        </PropertyGroup>
        <Error Condition="'$(_LaunchPadDovetailSdkVersion)' == ''" Text="Directory.Packages.props pins no version of Joinery.Dovetail.Sdk, which Rocket.Surgery.LaunchPad.Sdk chains." />
        <ItemGroup>
            <!-- %24 is $ and %27 is ': the file reads the consumer's properties, which must not be expanded here -->
            <_LaunchPadPackagesPropsLine Include="&lt;Project&gt;" />
            <_LaunchPadPackagesPropsLine Include="&lt;!-- Generated when Rocket.Surgery.LaunchPad.Sdk is packed. Each version is only set when the application has not set it already. --&gt;" />
            <_LaunchPadPackagesPropsLine Include="&lt;PropertyGroup&gt;" />
            <_LaunchPadPackagesPropsLine
                Include="&lt;LaunchPadDovetailSdkVersion Condition=&quot;%27%24(LaunchPadDovetailSdkVersion)%27 == %27%27&quot;&gt;$(_LaunchPadDovetailSdkVersion)&lt;/LaunchPadDovetailSdkVersion&gt;"
            />
            <_LaunchPadPackagesPropsLine
                Include="&lt;LaunchPadVersion Condition=&quot;%27%24(LaunchPadVersion)%27 == %27%27&quot;&gt;$(PackageVersion)&lt;/LaunchPadVersion&gt;"
            />
            <_LaunchPadPackagesPropsLine Include="&lt;/PropertyGroup&gt;" />
            <_LaunchPadPackagesPropsLine Include="&lt;/Project&gt;" />
        </ItemGroup>
        <WriteLinesToFile File="$(_LaunchPadPackagesProps)" Lines="@(_LaunchPadPackagesPropsLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <None Include="$(_LaunchPadPackagesProps)" Pack="true" PackagePath="Sdk" />
            <FileWrites Include="$(_LaunchPadPackagesProps)" />
        </ItemGroup>
    </Target>
</Project>
