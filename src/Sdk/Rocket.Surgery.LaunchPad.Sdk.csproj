<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <PackageType>MSBuildSdk</PackageType>
        <NoBuildOutput>true</NoBuildOutput>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <ImplicitUsings>disable</ImplicitUsings>
        <PackageDescription>MSBuild SDK for LaunchPad: chains Joinery.Dovetail.Sdk and adds the LaunchPad packages for what an application is and references</PackageDescription>
        <PackageTags>$(PackageTags);sdk;msbuild</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Sdk/**" />
        <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />
        <Using Remove="**" />
    </ItemGroup>

    <!-- the Dovetail SDK this SDK chains; Rocket.Surgery.LaunchPad.Sdk.Pack.targets writes its version into Sdk/Packages.props -->
    <PropertyGroup>
        <LaunchPadChainedSdk>Joinery.Dovetail.Sdk</LaunchPadChainedSdk>
    </PropertyGroup>
    <Import Project="Rocket.Surgery.LaunchPad.Sdk.Pack.targets" />
</Project>
