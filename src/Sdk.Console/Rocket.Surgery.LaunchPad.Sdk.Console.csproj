<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <PackageType>MSBuildSdk</PackageType>
        <NoBuildOutput>true</NoBuildOutput>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <ImplicitUsings>disable</ImplicitUsings>
        <PackageDescription>MSBuild SDK for LaunchPad console applications: chains Joinery.Dovetail.Sdk.Console (ConsoleAppFramework) and adds the LaunchPad packages for what an application is and references</PackageDescription>
        <PackageTags>$(PackageTags);sdk;msbuild;msbuild-sdk;dovetail;console;cli;consoleappframework</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Sdk/**" />
        <Using Remove="**" />
        <!-- its own Sdk.props and Sdk.targets, which chain Joinery.Dovetail.Sdk.Console -->
        <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />
        <!-- everything else is Rocket.Surgery.LaunchPad.Sdk's: the shared props and the package detection -->
        <None
            Include="../Sdk/Sdk/**"
            Exclude="../Sdk/Sdk/Sdk.props;../Sdk/Sdk/Sdk.targets"
            Pack="true"
            PackagePath="Sdk/"
            Link="Sdk/Shared/%(RecursiveDir)%(Filename)%(Extension)"
        />
    </ItemGroup>

    <PropertyGroup>
        <LaunchPadChainedSdk>Joinery.Dovetail.Sdk.Console</LaunchPadChainedSdk>
    </PropertyGroup>
    <Import Project="../Sdk/Rocket.Surgery.LaunchPad.Sdk.Pack.targets" />
</Project>
