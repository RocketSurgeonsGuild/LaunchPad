<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <PackageDescription>
            ZeroAlloc.Mediator validation for LaunchPad GraphQL servers: a rejected request reports one VALIDATION error per failure, naming the
            property that failed.
        </PackageDescription>
        <PackageTags>$(PackageTags);zeroalloc;validation;graphql;hotchocolate</PackageTags>
        <!--
            The types live in the Rocket.Surgery.LaunchPad.HotChocolate namespaces. A namespace of Rocket.Surgery.LaunchPad.ZeroAlloc would shadow
            ZeroAlloc.* in LaunchPad code. The export class is named for the package so it does not collide with HotChocolate's.
        -->
        <RootNamespace>Rocket.Surgery.LaunchPad.HotChocolate</RootNamespace>
        <DovetailExportClassName>ZeroAllocExports</DovetailExportClassName>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\HotChocolate\Rocket.Surgery.LaunchPad.HotChocolate.csproj" />
        <PackageReference Include="HotChocolate" />
        <PackageReference Include="ZeroAlloc.Mediator.Validation" />
        <InternalsVisibleTo Include="ZeroAlloc.HotChocolate.Tests" />
    </ItemGroup>
</Project>
