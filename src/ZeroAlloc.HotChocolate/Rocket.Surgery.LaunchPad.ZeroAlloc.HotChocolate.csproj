<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
        <PackageDescription>ZeroAlloc.Mediator validation for LaunchPad GraphQL servers: a rejected request reports one VALIDATION error per failure, naming the property that failed.</PackageDescription>
        <PackageTags>$(PackageTags);dovetail;zeroalloc;zeroalloc-mediator;validation;hotchocolate;graphql</PackageTags>
        <!--
            The types live in the Rocket.Surgery.LaunchPad.HotChocolate namespaces. A namespace of Rocket.Surgery.LaunchPad.ZeroAlloc would shadow
            ZeroAlloc.* in LaunchPad code. The export class is named for the package so it does not collide with HotChocolate's.
        -->
        <RootNamespace>Rocket.Surgery.LaunchPad.HotChocolate</RootNamespace>
        <DovetailExportClassName>ZeroAllocExports</DovetailExportClassName>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\HotChocolate\Rocket.Surgery.LaunchPad.HotChocolate.csproj" />
        <PackageReference Include="HotChocolate" />
        <!-- A field whose request has policies is authorized through ASP.NET Core authorization, where LaunchPad checks them. -->
        <PackageReference Include="HotChocolate.AspNetCore.Authorization" />
        <PackageReference Include="ZeroAlloc.Mediator.Validation" />
        <InternalsVisibleTo Include="ZeroAlloc.HotChocolate.Tests" />
    </ItemGroup>
</Project>
