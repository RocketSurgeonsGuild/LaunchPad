<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
    <PackageDescription>StrawberryShake serializers for NetTopologySuite geometries and GeoJSON positions and coordinates, registered by a Dovetail joint so generated GraphQL clients read and write spatial scalars as GeoJSON.</PackageDescription>
    <PackageTags>$(PackageTags);dovetail;strawberryshake;graphql-client;nettopologysuite;geojson;spatial</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Joinery.Dovetail" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spatial\Rocket.Surgery.LaunchPad.Spatial.csproj" />
    <ProjectReference Include="..\StrawberryShake\Rocket.Surgery.LaunchPad.StrawberryShake.csproj" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
