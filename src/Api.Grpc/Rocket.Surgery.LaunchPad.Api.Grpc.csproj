<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../Api.Core/ApiGenerator.props" />
    <PropertyGroup>
        <PackageDescription>Generates code-first gRPC services (protobuf-net.Grpc) for LaunchPad operation hosts: list operations with [Operation&lt;TRequest&gt;] on a partial *Service class and call app.Map{Host}(). Works with any mediator.</PackageDescription>
        <PackageTags>$(PackageTags);source-generator;grpc;protobuf-net;mediator</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <!-- PrivateAssets none: the base package's analyzer (the attributes) must flow to whoever references this package. -->
        <ProjectReference Include="../Api/Rocket.Surgery.LaunchPad.Api.csproj" ReferenceOutputAssembly="false" PrivateAssets="none" />
    </ItemGroup>
</Project>
