<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <PackageDescription />
        <PackageTags>$(PackageTags)</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup>
        <None Include="build/*.*" Pack="true" PackagePath="build" />
        <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
        <None Include="buildTransitive/*.*" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Joinery.Dovetail" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
        <PackageReference Include="Specular" />
        <PackageReference Include="System.Text.Json" />
    </ItemGroup>
    <ItemGroup>
        <!-- The camel case enum converters of the JSON contexts in every project that references this package. -->
        <ProjectReference
            Include="..\Primitives.Analyzers\Rocket.Surgery.LaunchPad.Primitives.Analyzers.csproj"
            IncludeAssets="analyzers"
            ExcludeAssets="compile;runtime;native"
            PrivateAssets="contentfiles;build;buildMultitargeting;buildTransitive"
            OutputItemType="Analyzer"
        />
        <!-- The task that writes an application's JSON context (build/Rocket.Surgery.LaunchPad.Primitives.targets), packed under tasks/. -->
        <ProjectReference Include="..\Primitives.Tasks\Rocket.Surgery.LaunchPad.Primitives.Tasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>
    <Target Name="_LaunchPadPackJsonContextTask" BeforeTargets="_GetPackageFiles">
        <MSBuild Projects="..\Primitives.Tasks\Rocket.Surgery.LaunchPad.Primitives.Tasks.csproj" Targets="GetTargetPath">
            <Output TaskParameter="TargetOutputs" ItemName="_LaunchPadJsonContextTask" />
        </MSBuild>
        <ItemGroup>
            <None Include="@(_LaunchPadJsonContextTask)" Pack="true" PackagePath="tasks/netstandard2.0" Visible="false" />
        </ItemGroup>
    </Target>
</Project>
