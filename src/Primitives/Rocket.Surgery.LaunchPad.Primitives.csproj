<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Domain primitives (docs/adr/0011-primitives-is-a-port-of-dotnet-domain-primitives.md): an optional package that depends on no other
        package. An application or library opts in by referencing it, and declares its own domain primitives with the attributes the
        Primitives generator writes into it. Ported from dotnet-domain-primitives (MIT, see THIRD-PARTY-NOTICES.md).
    -->
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
        <PackageDescription>Domain primitives: strongly typed, validated values (strings, numbers, dates, strong IDs, smart enums and value objects) completed by a source generator, with ready-made kinds such as email addresses, currency codes and money.</PackageDescription>
        <PackageTags>$(PackageTags);domain-primitives;strong-types;value-objects;strongly-typed-id;smart-enum;primitive-obsession;iban;currency;money</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup>
        <None Include="build/*.*" Pack="true" PackagePath="build" />
        <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
        <None Include="buildTransitive/*.*" Pack="true" PackagePath="buildTransitive" />
        <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
    </ItemGroup>
    <ItemGroup>
        <!-- The Primitives generators and analyzers flow to every project that references Primitives. -->
        <ProjectReference
            Include="..\Primitives.Analyzers\Rocket.Surgery.LaunchPad.Primitives.Analyzers.csproj"
            IncludeAssets="analyzers"
            ExcludeAssets="compile;runtime;native"
            PrivateAssets="contentfiles;build;buildMultitargeting;buildTransitive"
            OutputItemType="Analyzer"
        />
    </ItemGroup>
    <ItemGroup>
        <!-- Primitives uses nothing of Dovetail; the joints it ships are templates compiled in the application. -->
        <Using Remove="Joinery.Dovetail" />
        <Using Remove="Joinery.Dovetail.Attributes" />
        <Using Remove="Joinery.Dovetail.Joints" />
    </ItemGroup>
</Project>
