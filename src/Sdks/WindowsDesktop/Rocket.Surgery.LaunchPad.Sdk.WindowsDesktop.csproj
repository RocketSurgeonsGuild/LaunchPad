<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- The SDK this one mirrors, and Dovetail's mirror of it, which it chains: src/Sdks/Directory.Build.targets packs it from them. -->
        <LaunchPadMicrosoftSdk>Microsoft.NET.Sdk.WindowsDesktop</LaunchPadMicrosoftSdk>
        <LaunchPadChainedSdk>Joinery.Dovetail.Sdk.WindowsDesktop</LaunchPadChainedSdk>
        <PackageTags>$(PackageTags);wpf;winforms;windows-desktop</PackageTags>
    </PropertyGroup>
</Project>
