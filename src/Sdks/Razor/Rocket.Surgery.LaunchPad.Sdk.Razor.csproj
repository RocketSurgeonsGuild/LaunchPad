<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- The SDK this one mirrors, and Dovetail's mirror of it, which it chains: src/Sdks/Directory.Build.targets packs it from them. -->
        <LaunchPadMicrosoftSdk>Microsoft.NET.Sdk.Razor</LaunchPadMicrosoftSdk>
        <LaunchPadChainedSdk>Joinery.Dovetail.Sdk.Razor</LaunchPadChainedSdk>
        <PackageTags>$(PackageTags);razor;razor-class-library</PackageTags>
    </PropertyGroup>
</Project>
