<Project>
    <!--
        What every LaunchPad SDK applies: Sdk/Sdk.props of Rocket.Surgery.LaunchPad.Sdk imports this file and then Joinery.Dovetail.Sdk,
        Sdk/Sdk.props of Rocket.Surgery.LaunchPad.Sdk.Console imports it and then Joinery.Dovetail.Sdk.Console, and each mirror of a Microsoft
        SDK (Rocket.Surgery.LaunchPad.Sdk.Web, ...) imports it after Dovetail's mirror (Rocket.Surgery.LaunchPad.Mirror.props). Every LaunchPad
        SDK package ships this file and the detection files, packed from src/Sdks/LaunchPad/Sdk. Each SDK imports its Packages.props (the
        versions of the packages the SDK adds and of the Dovetail and Chirograph SDKs it chains) itself, before this file.
    -->

    <!--
        LaunchPad turns on what Dovetail leaves off. Dovetail's SDK reads these after the project has been evaluated, so a project (or a
        Directory.Build.props below the SDK entry) that sets one to false still wins.
          - DovetailEnableSerilog: a project that references Serilog directly gets Joinery.Dovetail.Serilog.
    -->
    <PropertyGroup>
        <DovetailEnableSerilog Condition="'$(DovetailEnableSerilog)' == ''">true</DovetailEnableSerilog>
    </PropertyGroup>

    <!--
        Dovetail's host detection runs through CustomAfterMicrosoftCommonTargets, after the whole project has been evaluated, as it reads
        properties the project sets (OutputType). LaunchPad's detection reads what Dovetail's found (the DovetailHost items), so it has to come
        after it: MSBuild imports the files of the list in order. It is added before Dovetail's Sdk.props is imported, which puts host detection
        in front of it and the file that turns the DovetailSdkImplicitPackageReference items of both into PackageReferences behind it.
    -->
    <PropertyGroup>
        <CustomAfterMicrosoftCommonTargets>$(CustomAfterMicrosoftCommonTargets);$(MSBuildThisFileDirectory)Rocket.Surgery.LaunchPad.Detection.targets</CustomAfterMicrosoftCommonTargets>
    </PropertyGroup>

    <!--
        Chirograph, which generates the HTTP clients of the project's OpenApiClient items, chained after the whole project has been evaluated
        (Rocket.Surgery.LaunchPad.Chirograph.targets).
    -->
    <PropertyGroup>
        <CustomAfterMicrosoftCommonTargets>$(CustomAfterMicrosoftCommonTargets);$(MSBuildThisFileDirectory)Rocket.Surgery.LaunchPad.Chirograph.targets</CustomAfterMicrosoftCommonTargets>
    </PropertyGroup>

    <!-- The minimum target framework: an older .NET stops with a clear error (Rocket.Surgery.LaunchPad.TargetFramework.targets). -->
    <PropertyGroup>
        <CustomAfterMicrosoftCommonTargets>$(CustomAfterMicrosoftCommonTargets);$(MSBuildThisFileDirectory)Rocket.Surgery.LaunchPad.TargetFramework.targets</CustomAfterMicrosoftCommonTargets>
    </PropertyGroup>
</Project>
