<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- The SDK this one mirrors, and Dovetail's mirror of it, which it chains: src/Sdks/Directory.Build.targets packs it from them. -->
        <LaunchPadMicrosoftSdk>Microsoft.NET.Sdk.Worker</LaunchPadMicrosoftSdk>
        <LaunchPadChainedSdk>Joinery.Dovetail.Sdk.Worker</LaunchPadChainedSdk>
        <PackageTags>$(PackageTags);worker-service;background-service</PackageTags>
    </PropertyGroup>
</Project>
