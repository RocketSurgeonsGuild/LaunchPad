<Project>
    <!--
        Rocket.Surgery.LaunchPad.Sdk.Aspire.AppHost is Aspire.AppHost.Sdk with LaunchPad. A project swaps the one for the other and changes nothing else:

            <Project Sdk="Rocket.Surgery.LaunchPad.Sdk.Aspire.AppHost">

        with the version under msbuild-sdks in global.json, or in the attribute (Rocket.Surgery.LaunchPad.Sdk.Aspire.AppHost/1.2.3). It is the same as Aspire.AppHost.Sdk with
        <Sdk Name="Rocket.Surgery.LaunchPad.Sdk" /> next to it.

        Aspire AppHosts. Joinery.Dovetail.Sdk.Aspire.AppHost imports Aspire.AppHost.Sdk at the version Dovetail was built against
        (DovetailAspireAppHostSdkVersion picks another). Dovetail detects a HostApplication host for an AppHost, but an AppHost orchestrates
        the application rather than being one, so LaunchPad leaves its hosting packages out (Rocket.Surgery.LaunchPad.Detection.targets).

        It chains Joinery.Dovetail.Sdk.Aspire.AppHost, Dovetail's mirror of Aspire.AppHost.Sdk, which imports the Microsoft SDK and then Joinery.Dovetail.Sdk, and then
        applies what every LaunchPad SDK applies (Rocket.Surgery.LaunchPad.Mirror.props). Under a Directory.Build.props that already applies
        Joinery.Dovetail.Sdk or a LaunchPad SDK, neither is applied a second time.
    -->

    <!--
        The versions of the packages the SDK adds and of the Dovetail SDK it chains, generated when the SDK is packed. The version of the
        import wins over a Joinery.Dovetail.Sdk.Aspire.AppHost entry in global.json. It is read before the Microsoft SDK imports the Directory.Build.props, so to
        chain another version set LaunchPadDovetailSdkVersion as a global property or an environment variable
        (dotnet build -p:LaunchPadDovetailSdkVersion=1.2.3). Sdk.targets imports the same version, whatever the project sets in between.
    -->
    <Import Project="$(MSBuildThisFileDirectory)Packages.props" />
    <PropertyGroup>
        <_LaunchPadMirrorDovetailSdkVersion>$(LaunchPadDovetailSdkVersion)</_LaunchPadMirrorDovetailSdkVersion>
    </PropertyGroup>
    <Import Project="Sdk.props" Sdk="Joinery.Dovetail.Sdk.Aspire.AppHost" Version="$(_LaunchPadMirrorDovetailSdkVersion)" />
    <Import Project="$(MSBuildThisFileDirectory)Rocket.Surgery.LaunchPad.Mirror.props" />
</Project>
