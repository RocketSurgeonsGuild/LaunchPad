<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
        <PackageDescription>Dovetail joint that registers ASP.NET Core gRPC for the gRPC services LaunchPad generates from operation hosts, which answer each error case of a union response with its gRPC status.</PackageDescription>
        <PackageTags>$(PackageTags);dovetail;grpc;grpc-aspnetcore;aspnetcore;rpc</PackageTags>
        <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\AspNetCore\Rocket.Surgery.LaunchPad.AspNetCore.csproj"
            IncludeAssets="all" />
        <ProjectReference Include="..\Hosting\Rocket.Surgery.LaunchPad.Hosting.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Grpc.Tests" />
    </ItemGroup>
</Project>
