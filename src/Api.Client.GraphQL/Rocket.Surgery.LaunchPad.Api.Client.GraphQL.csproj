<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../Api.Core/ApiGenerator.props" />
    <PropertyGroup>
        <PackageDescription>Generates GraphQL clients for LaunchPad operation hosts: list mutations with [Operation&lt;TRequest&gt;] on a partial *GraphQLClient class to get typed methods and one mediator handler per operation, so mediator.Send works the same on the client as on the server. Works with any mediator.</PackageDescription>
        <PackageTags>$(PackageTags);source-generator;graphql;mediator</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Api/Rocket.Surgery.LaunchPad.Api.csproj" ReferenceOutputAssembly="false" PrivateAssets="none" />
    </ItemGroup>
</Project>
