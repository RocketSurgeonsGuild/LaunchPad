<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <PackageDescription />
        <PackageTags>$(PackageTags)</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <!--
            The joints this package ships are templates (build/*.cs.template), written into the application that references the package
            and compiled against whatever that application references, so the package depends on none of it: no health checks, no Serilog,
            no OpenTelemetry. See build/Rocket.Surgery.LaunchPad.Hosting.targets for how a template is declared.
        -->
        <None Include="build/*.*" Pack="true" PackagePath="build" />
        <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
        <None Include="buildTransitive/*.*" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>
    <ItemGroup>
        <!-- the templates are joints, so the application needs Dovetail (and its generator) for them to be written at all -->
        <PackageReference Include="Joinery.Dovetail" />
    </ItemGroup>
</Project>
