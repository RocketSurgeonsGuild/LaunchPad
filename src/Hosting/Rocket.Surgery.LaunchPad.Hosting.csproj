<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
        <PackageDescription>Dovetail joints for health checks, Serilog enrichers and sinks, OpenTelemetry instrumentation and Blazor WebAssembly logging, shipped as source templates that an application gets only when it references what each joint needs.</PackageDescription>
        <PackageTags>$(PackageTags);dovetail;hosting;generic-host;logging;serilog;opentelemetry;health-checks;webassembly</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <!--
            The joints this package ships are templates (build/*.cs.template), written into the application that references the package
            and compiled against whatever that application references, so the package depends on none of it: no health checks, no Serilog,
            no OpenTelemetry. See build/Rocket.Surgery.LaunchPad.Hosting.targets for how a template is declared.
        -->
        <None Include="build/*.*" Pack="true" PackagePath="build" />
        <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
        <None Include="buildTransitive/*.*" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>
    <ItemGroup>
        <!-- the templates are joints, so the application needs Dovetail (and its generator) for them to be written at all -->
        <PackageReference Include="Joinery.Dovetail" />
    </ItemGroup>
</Project>
