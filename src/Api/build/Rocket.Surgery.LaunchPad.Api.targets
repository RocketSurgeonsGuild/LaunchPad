<Project>
    <!--
        Tells the API generators which mediator source generators run in this project. martinothamar/Mediator and Foundatio only dispatch to
        handlers their own generator sees, and ZeroAlloc's handlers extend what its generator writes, so a generated client host has to sit on
        the right side of that generator (LPAD1012). Generators can't see each other, so the build hands the list over.
    -->
    <ItemGroup>
        <CompilerVisibleProperty Include="LaunchPadApiMediatorGenerators" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="LaunchPadApiDocumentation" />
    </ItemGroup>
    <!--
        Operation summaries and descriptions come from the requests' XML documentation, and the compiler only gives generators the
        documentation of source symbols. So the XML documentation files of the referenced projects are handed over as additional files.
        A contracts package can be added the same way: <AdditionalFiles Include="path/to/Contracts.xml" LaunchPadApiDocumentation="true" />.
    -->
    <Target Name="_LaunchPadApiReferenceDocumentation" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun" DependsOnTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <_LaunchPadApiProjectReference Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
            <_LaunchPadApiDocumentationCandidate Include="@(_LaunchPadApiProjectReference->'%(RootDir)%(Directory)%(Filename).xml')" />
            <!-- A reference assembly (obj/ref/X.dll) has its documentation one folder up. -->
            <_LaunchPadApiDocumentationCandidate Include="@(_LaunchPadApiProjectReference->'%(RootDir)%(Directory)../%(Filename).xml')" />
            <AdditionalFiles
                Include="@(_LaunchPadApiDocumentationCandidate->'%(FullPath)')"
                Condition="Exists('%(_LaunchPadApiDocumentationCandidate.FullPath)')"
                LaunchPadApiDocumentation="true"
            />
        </ItemGroup>
    </Target>
    <Target Name="_LaunchPadApiMediatorGenerators" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
        <ItemGroup>
            <_LaunchPadApiMediatorGenerator
                Include="@(Analyzer->'%(Filename)')"
                Condition="'%(Filename)' == 'Mediator.SourceGenerator' or '%(Filename)' == 'Foundatio.Mediator' or '%(Filename)' == 'ZeroAlloc.Mediator.Generator'"
            />
        </ItemGroup>
        <PropertyGroup>
            <!--
                Never empty, so the generators can tell "none run here" from "the build didn't say". Separated by | because the generated
                .editorconfig treats ; and # as the start of a comment.
            -->
            <LaunchPadApiMediatorGenerators>|@(_LaunchPadApiMediatorGenerator->Distinct(), '|')|</LaunchPadApiMediatorGenerators>
        </PropertyGroup>
    </Target>
</Project>
