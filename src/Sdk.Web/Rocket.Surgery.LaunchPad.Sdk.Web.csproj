<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <PackageType>MSBuildSdk</PackageType>
        <NoBuildOutput>true</NoBuildOutput>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <ImplicitUsings>disable</ImplicitUsings>
        <PackageDescription>MSBuild SDK for a LaunchPad web application: Microsoft.NET.Sdk.Web and Rocket.Surgery.LaunchPad.Sdk as one project SDK</PackageDescription>
        <PackageTags>$(PackageTags);sdk;msbuild;web</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Sdk/**" />
        <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />
        <Using Remove="**" />
    </ItemGroup>

    <!--
        Writes Sdk/Packages.props into the package: LaunchPadSdkVersion, the version of Rocket.Surgery.LaunchPad.Sdk that Sdk/Sdk.props chains.
        Every LaunchPad package ships at the same version, so it is the version of this SDK. An application can set it first to chain another.
    -->
    <Target Name="_LaunchPadWebGeneratePackagesProps" BeforeTargets="_GetPackageFiles;Pack">
        <PropertyGroup>
            <_LaunchPadWebPackagesProps>$(IntermediateOutputPath)Packages.props</_LaunchPadWebPackagesProps>
        </PropertyGroup>
        <ItemGroup>
            <!-- %24 is $ and %27 is ': the file reads the consumer's properties, which must not be expanded here -->
            <_LaunchPadWebPackagesPropsLine Include="&lt;Project&gt;" />
            <_LaunchPadWebPackagesPropsLine Include="&lt;!-- Generated when Rocket.Surgery.LaunchPad.Sdk.Web is packed. The version is only set when the application has not set it already. --&gt;" />
            <_LaunchPadWebPackagesPropsLine Include="&lt;PropertyGroup&gt;" />
            <_LaunchPadWebPackagesPropsLine
                Include="&lt;LaunchPadSdkVersion Condition=&quot;%27%24(LaunchPadSdkVersion)%27 == %27%27&quot;&gt;$(PackageVersion)&lt;/LaunchPadSdkVersion&gt;"
            />
            <_LaunchPadWebPackagesPropsLine Include="&lt;/PropertyGroup&gt;" />
            <_LaunchPadWebPackagesPropsLine Include="&lt;/Project&gt;" />
        </ItemGroup>
        <WriteLinesToFile File="$(_LaunchPadWebPackagesProps)" Lines="@(_LaunchPadWebPackagesPropsLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <None Include="$(_LaunchPadWebPackagesProps)" Pack="true" PackagePath="Sdk" />
            <FileWrites Include="$(_LaunchPadWebPackagesProps)" />
        </ItemGroup>
    </Target>
</Project>
