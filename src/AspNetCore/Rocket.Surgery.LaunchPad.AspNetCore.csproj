<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageDescription>Dovetail joints for ASP.NET Core: MVC with application parts found by Specular, OpenAPI documents with LaunchPad's transformers, problem details, Serilog request logging, health check endpoints on a port of their own and the application's System.Text.Json options.</PackageDescription>
        <PackageTags>$(PackageTags);dovetail;aspnetcore;web-api;openapi;problem-details;serilog;request-logging;health-checks;opentelemetry;system-text-json</PackageTags>
        <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <None Include="build/*.*" Pack="true" PackagePath="build" />
        <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
        <None Include="buildTransitive/*.*" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <ProjectReference Include="..\Foundation\Rocket.Surgery.LaunchPad.Foundation.csproj" />
        <ProjectReference Include="..\Hosting\Rocket.Surgery.LaunchPad.Hosting.csproj" />
        <PackageReference Include="Joinery.Dovetail" />
        <!--
            LaunchPadHealthCheckOptions declares its section with [Optionary]: the binder and the schema metadata are generated into this
            assembly, so consumers need only Optionary's runtime library. Its build targets stay private: they hand every referenced
            package's XML documentation to the compiler as additional files, which ASP.NET Core's OpenAPI XML comment generator reads too
            and turns into more string literals than a program may hold (CS8103).
        -->
        <PackageReference Include="Optionary" PrivateAssets="analyzers;build;buildMultiTargeting;buildTransitive" />
        <PackageReference Include="Rocket.Surgery.Build.Information" />
        <PackageReference Include="Specular" />
        <PackageReference Include="Serilog.AspNetCore" />
        <!--
            Only the instrumentation, which depends on the OpenTelemetry API alone: LaunchPad.Hosting's ASP.NET Core instrumentation joint
            uses it once the application turns OpenTelemetry on (it references Joinery.Dovetail.OpenTelemetry).
        -->
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    </ItemGroup>
</Project>