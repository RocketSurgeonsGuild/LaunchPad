<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <PackageDescription />
        <PackageTags>$(PackageTags)</PackageTags>
        <!-- The types keep the Rocket.Surgery.LaunchPad.Spatial namespace they had in the Spatial package. The export class is named for the package. -->
        <RootNamespace>Rocket.Surgery.LaunchPad.Spatial</RootNamespace>
        <DovetailExportClassName>SpatialSerilogExports</DovetailExportClassName>
    </PropertyGroup>
    <ItemGroup>
        <!-- Serilog comes with Dovetail's Serilog package, which also brings the ISerilogJoint the joint implements. -->
        <PackageReference Include="Joinery.Dovetail" />
        <PackageReference Include="Joinery.Dovetail.Serilog" />
        <PackageReference Include="NetTopologySuite" />
        <PackageReference Include="NetTopologySuite.Features" />
    </ItemGroup>
</Project>
