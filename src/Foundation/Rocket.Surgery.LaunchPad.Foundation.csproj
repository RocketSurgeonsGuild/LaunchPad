<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
        <PackageDescription>Dovetail joints for options, logging, Specular service registrations, camel case System.Text.Json, and HttpClient resilience and service discovery, plus the Problem error cases of union responses and LaunchPad's source generators.</PackageDescription>
        <PackageTags>$(PackageTags);dovetail;dependency-injection;configuration;system-text-json;aot;http-resilience;service-discovery;problem-details;discriminated-unions</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- NU5100: the JSON context MSBuild task is packed under tasks/ on purpose; build/ loads it, nothing references it -->
        <NoWarn>$(NoWarn);NU5100</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <None Include="build/*.*" Pack="true" PackagePath="build" />
        <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
        <None Include="buildTransitive/*.*" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Joinery.Dovetail" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
        <PackageReference Include="Specular" />
    </ItemGroup>
    <ItemGroup>
        <!--
            LaunchPad's one analyzer assembly (docs/adr/0004-one-generator-assembly.md): the operation host, property tracking and union
            generators, and the JSON generators (enum converters, JSON context manifest). They run on Foundation itself and flow to every
            project that references it.
        -->
        <ProjectReference
            Include="..\Analyzers\Rocket.Surgery.LaunchPad.Analyzers.csproj"
            IncludeAssets="analyzers"
            ExcludeAssets="compile;runtime;native"
            PrivateAssets="contentfiles;build;buildMultitargeting;buildTransitive"
            OutputItemType="Analyzer"
        />
        <!-- The task that writes an application's JSON context (build/Rocket.Surgery.LaunchPad.Foundation.JsonContext.targets), packed under tasks/. -->
        <ProjectReference Include="..\Foundation.Tasks\Rocket.Surgery.LaunchPad.Foundation.Tasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>
    <Target Name="_LaunchPadPackJsonContextTask" BeforeTargets="_GetPackageFiles">
        <MSBuild Projects="..\Foundation.Tasks\Rocket.Surgery.LaunchPad.Foundation.Tasks.csproj" Targets="GetTargetPath">
            <Output TaskParameter="TargetOutputs" ItemName="_LaunchPadJsonContextTask" />
        </MSBuild>
        <ItemGroup>
            <None Include="@(_LaunchPadJsonContextTask)" Pack="true" PackagePath="tasks/netstandard2.0" Visible="false" />
        </ItemGroup>
    </Target>
</Project>
