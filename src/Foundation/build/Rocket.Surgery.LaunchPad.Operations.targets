<Project>
    <ItemGroup>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="LaunchPadApiDocumentation" />
        <!--
            A trimmed or native AOT project gets LPAD1030 for each Minimal API body or response type no JsonSerializerContext declares.
            LaunchPadApiRequireJsonContext=true turns the check on for any project, false turns it off.
        -->
        <CompilerVisibleProperty Include="PublishAot" />
        <CompilerVisibleProperty Include="IsAotCompatible" />
        <CompilerVisibleProperty Include="PublishTrimmed" />
        <CompilerVisibleProperty Include="IsTrimmable" />
        <CompilerVisibleProperty Include="LaunchPadApiRequireJsonContext" />
    </ItemGroup>
    <!--
        Operation summaries and descriptions, and the descriptions of the schemas in the OpenAPI document, come from XML documentation, and
        the compiler only gives generators the documentation of source symbols. So the XML documentation files of the referenced projects,
        and of LaunchPad's own packages (the standard problem cases: NotFound, Forbidden, ...), are handed over as additional files.
        A contracts package can be added the same way: <AdditionalFiles Include="path/to/Contracts.xml" LaunchPadApiDocumentation="true" />.
    -->
    <Target Name="_LaunchPadApiReferenceDocumentation" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun" DependsOnTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <_LaunchPadApiProjectReference Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
            <_LaunchPadApiDocumentationCandidate Include="@(_LaunchPadApiProjectReference->'%(RootDir)%(Directory)%(Filename).xml')" />
            <!-- A reference assembly (obj/ref/X.dll) has its documentation one folder up. -->
            <_LaunchPadApiDocumentationCandidate Include="@(_LaunchPadApiProjectReference->'%(RootDir)%(Directory)../%(Filename).xml')" />
            <_LaunchPadApiPackageReference Include="@(ReferencePath)" Condition="$([System.String]::Copy('%(ReferencePath.NuGetPackageId)').StartsWith('Rocket.Surgery.LaunchPad'))" />
            <_LaunchPadApiDocumentationCandidate Include="@(_LaunchPadApiPackageReference->'%(RootDir)%(Directory)%(Filename).xml')" />
            <AdditionalFiles
                Include="@(_LaunchPadApiDocumentationCandidate->'%(FullPath)')"
                Condition="Exists('%(_LaunchPadApiDocumentationCandidate.FullPath)')"
                LaunchPadApiDocumentation="true"
            />
        </ItemGroup>
    </Target>
    <!--
        Other packages' targets (Dovetail's reference documentation) add the same XML files as additional files of their own, and the editorconfig
        the compiler reads keeps the last item's metadata. So every additional file that is one of these candidates is marked, just before the
        editorconfig is written.
    -->
    <Target Name="_LaunchPadApiMarkReferenceDocumentation" BeforeTargets="GenerateMSBuildEditorConfigFileCore" DependsOnTargets="_LaunchPadApiReferenceDocumentation">
        <PropertyGroup>
            <_LaunchPadApiDocumentationPaths>;@(_LaunchPadApiDocumentationCandidate->'%(FullPath)');</_LaunchPadApiDocumentationPaths>
        </PropertyGroup>
        <ItemGroup>
            <AdditionalFiles Condition="$(_LaunchPadApiDocumentationPaths.Contains(';%(AdditionalFiles.FullPath);'))">
                <LaunchPadApiDocumentation>true</LaunchPadApiDocumentation>
            </AdditionalFiles>
        </ItemGroup>
    </Target>
</Project>
