<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <PackageDescription />
        <PackageTags>$(PackageTags)</PackageTags>
        <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
        <!--
            The types keep the Rocket.Surgery.LaunchPad.Grpc namespaces they had in Grpc. A namespace of Rocket.Surgery.LaunchPad.FluentValidation
            would shadow FluentValidation.* in LaunchPad code. The export class is named for the package so it does not collide with Grpc's.
        -->
        <RootNamespace>Rocket.Surgery.LaunchPad.Grpc</RootNamespace>
        <DovetailExportClassName>FluentValidationExports</DovetailExportClassName>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\FluentValidation\Rocket.Surgery.LaunchPad.FluentValidation.csproj" />
        <ProjectReference Include="..\Grpc\Rocket.Surgery.LaunchPad.Grpc.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="Grpc.AspNetCore" />
        <PackageReference Include="Joinery.Dovetail" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="FluentValidation.Grpc.Tests" />
    </ItemGroup>
</Project>
