<Project>
    <!--
        A file-based program under sample/ isn't a sample: the Blazor gateway Aspire.Hosting.Blazor writes into Sample.AppHost's output
        (bin/.../Scripts/Gateway.cs) and builds with its own package versions. It gets nothing from this file.
    -->
    <PropertyGroup>
        <_SampleProject Condition="'$(FileBasedProgram)' != 'true'">true</_SampleProject>
    </PropertyGroup>
    <ItemGroup Condition="'$(_SampleProject)' == 'true'">
        <ProjectReference Include="../../src/Analyzers/Rocket.Surgery.LaunchPad.Analyzers.csproj" PrivateAssets="none" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <!-- The union, enum converter and JSON context manifest generators, which the Foundation package brings through NuGet; project references don't. -->
        <ProjectReference Include="../../src/Analyzers/Rocket.Surgery.LaunchPad.Analyzers.csproj" PrivateAssets="none" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <!--
        The server applications log through Serilog: Joinery.Dovetail.Serilog creates the logger, and the packages of the enrichers and sinks
        turn on the Serilog joints LaunchPad.Hosting writes into an application (src/Hosting/build/Rocket.Surgery.LaunchPad.Hosting.targets).
        The LaunchPad SDK adds the OpenTelemetry packages to an application (src/Sdks/LaunchPad/Sdk/Rocket.Surgery.LaunchPad.Detection.OpenTelemetry.targets),
        and will add the Serilog ones (RocketSurgeonsGuild/LaunchPad#3075); the samples, which reference LaunchPad through projects, name them.

        They also turn on OpenTelemetry: Joinery.Dovetail.OpenTelemetry with OpenTelemetry.Extensions.Hosting adds it to the services, and the
        instrumentation and OTLP exporter packages turn on LaunchPad.Hosting's OpenTelemetry joints. Nothing is exported unless
        OTEL_EXPORTER_OTLP_ENDPOINT is set, as Sample.AppHost sets it: the OpenTelemetry sink's joint and the OTLP exporter's joint only write
        to it then. The AppHost itself is an Exe too, and gets none of this. Sample.BlazorWasm names its own browser telemetry packages.
    -->
    <ItemGroup Condition="'$(_SampleProject)' == 'true' and '$(OutputType)' == 'Exe' and '$(UsingMicrosoftNETSdkBlazorWebAssembly)' != 'true' and '$(IsAspireHost)' != 'true'">
        <PackageReference Include="Joinery.Dovetail.Serilog" />
        <PackageReference Include="Serilog.Enrichers.AssemblyName" />
        <PackageReference Include="Serilog.Enrichers.Demystifier" />
        <PackageReference Include="Serilog.Enrichers.Environment" />
        <PackageReference Include="Serilog.Enrichers.Process" />
        <PackageReference Include="Serilog.Enrichers.Span" />
        <PackageReference Include="Serilog.Enrichers.Thread" />
        <PackageReference Include="Serilog.Exceptions" />
        <PackageReference Include="Serilog.Extensions.Hosting" />
        <PackageReference Include="Serilog.Sinks.Async" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.Debug" />
        <PackageReference Include="Serilog.Sinks.Trace" />
        <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
        <PackageReference Include="Joinery.Dovetail.OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Process" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    </ItemGroup>
    <ItemGroup Condition="'$(_SampleProject)' == 'true' and '$(UsingMicrosoftNETSdkWeb)' == 'true'">
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    </ItemGroup>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
    <!-- What Foundation's package adds through NuGet for the operation host generators (referenced XML documentation); project references don't import it. -->
    <Import Project="$(MSBuildThisFileDirectory)../src/Foundation/build/Rocket.Surgery.LaunchPad.Operations.targets" Condition="'$(_SampleProject)' == 'true'" />
</Project>
