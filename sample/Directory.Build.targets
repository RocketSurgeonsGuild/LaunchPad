<Project>
    <ItemGroup>
        <ProjectReference Include="../../src/Analyzers/Rocket.Surgery.LaunchPad.Analyzers.csproj" PrivateAssets="none" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <!-- The camel case enum converters of the samples' JSON contexts; Rocket.Surgery.LaunchPad.Primitives brings it through NuGet. -->
        <ProjectReference Include="../../src/Primitives.Analyzers/Rocket.Surgery.LaunchPad.Primitives.Analyzers.csproj" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <!-- The task that writes the samples' JSON contexts, which Rocket.Surgery.LaunchPad.Primitives brings through NuGet. -->
        <ProjectReference Include="../../src/Primitives.Tasks/Rocket.Surgery.LaunchPad.Primitives.Tasks.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
        <PackageReference Include="JetBrains.Annotations.Sources" PrivateAssets="all" />
    </ItemGroup>
    <!--
        The server applications log through Serilog: Joinery.Dovetail.Serilog creates the logger, and the packages of the enrichers and sinks
        turn on the Serilog joints LaunchPad.Hosting writes into an application (src/Hosting/build/Rocket.Surgery.LaunchPad.Hosting.targets).
        The OpenTelemetry sink is left out, so the samples export no logs. The LaunchPad SDK adds these packages to an application
        (RocketSurgeonsGuild/LaunchPad#3075); the samples name them until it does.
    -->
    <ItemGroup Condition="'$(OutputType)' == 'Exe' and '$(UsingMicrosoftNETSdkBlazorWebAssembly)' != 'true'">
        <PackageReference Include="Joinery.Dovetail.Serilog" />
        <PackageReference Include="Serilog.Enrichers.AssemblyName" />
        <PackageReference Include="Serilog.Enrichers.Demystifier" />
        <PackageReference Include="Serilog.Enrichers.Environment" />
        <PackageReference Include="Serilog.Enrichers.Process" />
        <PackageReference Include="Serilog.Enrichers.Span" />
        <PackageReference Include="Serilog.Enrichers.Thread" />
        <PackageReference Include="Serilog.Exceptions" />
        <PackageReference Include="Serilog.Extensions.Hosting" />
        <PackageReference Include="Serilog.Sinks.Async" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.Debug" />
        <PackageReference Include="Serilog.Sinks.Trace" />
    </ItemGroup>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
    <!-- What the API generators' base package adds through NuGet (mediator generators, referenced XML documentation); project references don't import it. -->
    <Import Project="$(MSBuildThisFileDirectory)../src/Api/build/Rocket.Surgery.LaunchPad.Api.targets" />
</Project>
