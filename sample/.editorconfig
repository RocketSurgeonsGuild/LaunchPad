resharper_virtual_member_call_in_constructor_highlighting = none
resharper_nullable_warning_suppression_is_used_highlighting = none

# ZeroAlloc.Mediator reports every handler without a parameterless constructor, because the static Mediator.Send can't make it. The samples
# send through the IMediator their hosts register, which resolves the handlers (and their DbContext) from DI, so the static path never runs.
dotnet_diagnostic.ZAM008.severity = none
