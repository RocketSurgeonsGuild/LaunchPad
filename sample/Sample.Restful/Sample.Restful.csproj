<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
        <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
        <IncludeOpenAPIAnalyzers>true</IncludeOpenAPIAnalyzers>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\AspNetCore\Rocket.Surgery.LaunchPad.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\AspNetCore.Mvc\Rocket.Surgery.LaunchPad.AspNetCore.Mvc.csproj" />
        <!-- turns the ZeroAlloc validation failures into 422 problem details -->
        <ProjectReference Include="..\..\src\ZeroAlloc.AspNetCore\Rocket.Surgery.LaunchPad.ZeroAlloc.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\Hosting\Rocket.Surgery.LaunchPad.Hosting.csproj" />
        <ProjectReference Include="..\Sample.Core\Sample.Core.csproj" />
        <!-- a direct reference, so the Primitives joints (the strong IDs in Entity Framework and OpenAPI, and the domain primitive metrics) are written into the application -->
        <ProjectReference Include="..\..\src\Primitives\Rocket.Surgery.LaunchPad.Primitives.csproj" />
        <!-- writes the OpenAPI document at build (OpenApiGenerateDocumentsOnBuild), which the sample tests generate their client from -->
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
        <PackageReference Include="Humanizer.Core" />
        <Compile Include="../Shared/SampleOpenApiSchemas.cs" Link="SampleOpenApiSchemas.cs" />
        <PackageReference Include="Joinery.Dovetail.Hosting" />
        <PackageReference Include="Swashbuckle.AspNetCore.ReDoc" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    </ItemGroup>
    <ItemGroup>
        <!-- ASP.NET Core's entry point: ConfigureDovetail on the WebApplicationBuilder -->
        <DovetailHost
            Include="WebApplication"
            HostBuilderType="global::Microsoft.AspNetCore.Builder.WebApplicationBuilder"
            HostBuilderName="builder"
            HostType="global::Microsoft.AspNetCore.Builder.WebApplication"
            HelperName="global::Joinery.Dovetail.DovetailHostApplicationHelpers"
        />
    </ItemGroup>
</Project>