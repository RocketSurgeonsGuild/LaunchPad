<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
        <IncludeOpenAPIAnalyzers>true</IncludeOpenAPIAnalyzers>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\AspNetCore\Rocket.Surgery.LaunchPad.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\FluentValidation.AspNetCore\Rocket.Surgery.LaunchPad.FluentValidation.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\Hosting\Rocket.Surgery.LaunchPad.Hosting.csproj" />
        <ProjectReference Include="..\..\src\Serilog.AspNetCore\Rocket.Surgery.LaunchPad.Serilog.AspNetCore.csproj" />
        <ProjectReference Include="..\Sample.Core\Sample.Core.csproj" />
        <PackageReference Include="Joinery.Dovetail.Hosting" />
        <PackageReference Include="Swashbuckle.AspNetCore.ReDoc" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
        <!-- using the verified unit test for the swagger document -->
        <!--<PackageReference
            Include="Microsoft.Extensions.ApiDescription.Server"
            PrivateAssets="all"
            IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive"
        />-->
    </ItemGroup>
    <ItemGroup>
        <!-- ASP.NET Core's entry point: ConfigureDovetail on the WebApplicationBuilder -->
        <DovetailHost
        Include="WebApplication"
        HostBuilderType="global::Microsoft.AspNetCore.Builder.WebApplicationBuilder"
        HostBuilderName="builder"
        HostType="global::Microsoft.AspNetCore.Builder.WebApplication"
        HelperName="global::Joinery.Dovetail.DovetailHostApplicationHelpers"
      />
      </ItemGroup>
</Project>
