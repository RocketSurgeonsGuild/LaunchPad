<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
    <Sdk Name="Chirograph" />
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadBrowserTargetFrameworks)</TargetFrameworks>
        <!--
            Sample.AppHost's Blazor integration builds this project and reads its static web assets without naming a framework, which a project
            with TargetFrameworks can't answer, so the AppHost names the one it runs on in this environment variable.
        -->
        <TargetFramework Condition="'$(LaunchPadSampleBrowserTargetFramework)' != ''">$(LaunchPadSampleBrowserTargetFramework)</TargetFramework>
        <TargetFrameworks Condition="'$(LaunchPadSampleBrowserTargetFramework)' != ''" />
        <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
        <PackageReference Include="Joinery.Dovetail.Hosting" />
        <!-- with LaunchPad.Hosting below, these turn on its browser templates: browser console logging and the host environment enrichment -->
        <PackageReference Include="Joinery.Dovetail.Serilog" />
        <PackageReference Include="Serilog.Sinks.BrowserConsole" />
        <!--
            OpenTelemetry, as the LaunchPad SDK adds it to a browser application: these turn on LaunchPad.Hosting's browser templates, which
            export to the OTLP route Sample.AppHost's Blazor gateway gives the client (wwwroot/Sample.BlazorWasm.lib.module.js reads it).
        -->
        <PackageReference Include="Joinery.Dovetail.OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <!-- the forms' view models are validated in the browser, with the same rules the server applies -->
        <PackageReference Include="ZeroAlloc.Validation" />
        <PackageReference Include="ZeroAlloc.Validation.Inject" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The rockets come from Sample.Minimal, through the Refit client Chirograph generates from the OpenAPI document the sample writes
            when it builds. Sample.AppHost gives the client its address (Program.cs reads it); Chirograph's joint registers it.
        -->
        <OpenApiClient Include="..\Sample.Minimal\Sample.Minimal.csproj" Generator="Refitter" ClientName="RocketsClient" Namespace="Sample.BlazorWasm.Client" />
        <!-- what Chirograph adds for a Refitter client, referenced here so central package management gives the version (NU1009) -->
        <PackageReference Include="Refit.HttpClientFactory" />
        <!-- a global using rather than one in each file: the generated code only exists after a build, so dotnet format sees the namespace as unused -->
        <Using Include="Sample.BlazorWasm.Client" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Sample.BlazorWasm.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Blazor WebAssembly's entry point: ConfigureDovetail on the WebAssemblyHostBuilder -->
        <DovetailHost
            Include="WebAssembly"
            HostBuilderType="global::Microsoft.AspNetCore.Components.WebAssembly.Hosting.WebAssemblyHostBuilder"
            HostBuilderName="builder"
            HostType="global::Microsoft.AspNetCore.Components.WebAssembly.Hosting.WebAssemblyHost"
        />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Hosting\Rocket.Surgery.LaunchPad.Hosting.csproj" />
        <ProjectReference Include="..\..\src\Foundation\Rocket.Surgery.LaunchPad.Foundation.csproj" />
        <!-- validates the forms with the ZeroAlloc validators -->
        <ProjectReference Include="..\..\src\ZeroAlloc.Blazor\Rocket.Surgery.LaunchPad.ZeroAlloc.Blazor.csproj" />
    </ItemGroup>

</Project>
