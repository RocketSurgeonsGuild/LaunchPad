<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
    <PropertyGroup>
        <TargetFrameworks>net10.0-browser;net11.0-browser</TargetFrameworks>
        <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
        <PackageReference Include="System.Net.Http.Json" />
        <PackageReference Include="Joinery.Dovetail.Hosting" />
        <!-- with LaunchPad.Hosting below, these turn on its browser templates: browser console logging and the host environment enrichment -->
        <PackageReference Include="Joinery.Dovetail.Serilog" />
        <PackageReference Include="Serilog.Sinks.BrowserConsole" />
    </ItemGroup>

    <ItemGroup>
        <!-- Blazor WebAssembly's entry point: ConfigureDovetail on the WebAssemblyHostBuilder -->
        <DovetailHost
            Include="WebAssembly"
            HostBuilderType="global::Microsoft.AspNetCore.Components.WebAssembly.Hosting.WebAssemblyHostBuilder"
            HostBuilderName="builder"
            HostType="global::Microsoft.AspNetCore.Components.WebAssembly.Hosting.WebAssemblyHost"
        />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Hosting\Rocket.Surgery.LaunchPad.Hosting.csproj" />
        <ProjectReference Include="..\..\src\FluentValidation.Blazor\Rocket.Surgery.LaunchPad.FluentValidation.Blazor.csproj" />
        <ProjectReference Include="..\..\src\Foundation\Rocket.Surgery.LaunchPad.Foundation.csproj" />
        <ProjectReference Include="..\Sample.Restful.Client\Sample.Restful.Client.csproj" />
    </ItemGroup>

</Project>
