<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
      <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Joinery.Dovetail.Hosting" />
    <ProjectReference Include="..\..\src\FluentValidation.Blazor\Rocket.Surgery.LaunchPad.FluentValidation.Blazor.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore\Rocket.Surgery.LaunchPad.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Hosting\Rocket.Surgery.LaunchPad.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Serilog.AspNetCore\Rocket.Surgery.LaunchPad.Serilog.AspNetCore.csproj" />
    <ProjectReference Include="..\Sample.Core\Sample.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="Pages\Shared\_Layout.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\Shared\_ValidationScriptsPartial.cshtml" />
  </ItemGroup>


  <ItemGroup>
    <!-- ASP.NET Core's entry point: ConfigureDovetail on the WebApplicationBuilder -->
    <DovetailHost
      Include="WebApplication"
      HostBuilderType="global::Microsoft.AspNetCore.Builder.WebApplicationBuilder"
      HostBuilderName="builder"
      HostType="global::Microsoft.AspNetCore.Builder.WebApplication"
      HelperName="global::Joinery.Dovetail.DovetailHostApplicationHelpers"
    />
  </ItemGroup>
</Project>
