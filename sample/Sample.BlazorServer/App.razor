@inject NavigationManager Navigation

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        @* A page marked [Authorize] runs operations whose policies require a caller: an anonymous visitor is offered the way to sign in. *@
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <p>Sign in to see this page.</p>
                <a href="/sign-in?returnUrl=@Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)">Sign in</a>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p>Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
