<!--
    The only LaunchPad wiring in this sample: applying Rocket.Surgery.LaunchPad.Sdk here (version pinned by global.json's msbuild-sdks)
    chains Joinery.Dovetail.Sdk, so every project below finds its host model and gets Dovetail and LaunchPad.Hosting for it. No project
    references LaunchPad or Dovetail itself.
-->
<Project Sdk="Rocket.Surgery.LaunchPad.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
