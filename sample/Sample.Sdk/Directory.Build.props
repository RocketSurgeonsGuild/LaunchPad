<!--
    Settings every project here shares. The LaunchPad wiring is in each project: its SDK is a LaunchPad SDK (Rocket.Surgery.LaunchPad.Sdk.Web,
    .Worker, .Console, or #:sdk Rocket.Surgery.LaunchPad.Sdk in the file-based app), which chains Dovetail's, so every project finds its host
    model and gets Dovetail and LaunchPad.Hosting for it. No project references LaunchPad or Dovetail itself.
    It stands for an application outside this repository, so it names its framework instead of reading the repository's
    LaunchPadTargetFrameworks: .NET 11 is the oldest the LaunchPad SDK accepts.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
