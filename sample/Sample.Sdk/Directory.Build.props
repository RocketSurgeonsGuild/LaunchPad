<!--
    Settings every project here shares. The LaunchPad wiring is in each project: <Sdk Name="Rocket.Surgery.LaunchPad.Sdk" Version="..." />
    next to its own SDK (#:sdk in the file-based app) chains Joinery.Dovetail.Sdk, so every project finds its host model and gets Dovetail
    and LaunchPad.Hosting for it. No project references LaunchPad or Dovetail itself.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
