<!--
    Packs Rocket.Surgery.LaunchPad.Sdk and the packages it adds into artifacts/nuget-sample at the version global.json pins for the SDK, so
    this sample consumes LaunchPad exactly as published packages, never through a ProjectReference or an import from src/.

        dotnet msbuild build/pack.proj

    Run it again after changing anything those packages are packed from, then build or run the sample as usual.
-->
<Project DefaultTargets="Pack">
  <PropertyGroup>
    <LaunchPadSampleVersion>0.0.0-sample</LaunchPadSampleVersion>
    <LaunchPadSampleFeed>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', 'artifacts', 'nuget-sample'))</LaunchPadSampleFeed>
    <LaunchPadSamplePackagesFolder>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '.nuget', 'packages'))</LaunchPadSamplePackagesFolder>
    <_LaunchPadSampleGlobalJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\global.json'))</_LaunchPadSampleGlobalJson>
    <!-- The package icon is a file the release pipeline puts in .temp, which a checkout does not have. -->
    <_LaunchPadSampleProperties>Configuration=Release;Version=$(LaunchPadSampleVersion);PackageOutputPath=$(LaunchPadSampleFeed);PackageIcon=</_LaunchPadSampleProperties>
  </PropertyGroup>

  <ItemGroup>
    <!-- the SDK, every package it can add to an application, and the LaunchPad packages those depend on -->
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\Sdk\Rocket.Surgery.LaunchPad.Sdk.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\Hosting\Rocket.Surgery.LaunchPad.Hosting.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\Primitives\Rocket.Surgery.LaunchPad.Primitives.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\Analyzers\Rocket.Surgery.LaunchPad.Analyzers.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\Foundation\Rocket.Surgery.LaunchPad.Foundation.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\AspNetCore\Rocket.Surgery.LaunchPad.AspNetCore.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\NodaTime\Rocket.Surgery.LaunchPad.NodaTime.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\NodaTime.HotChocolate\Rocket.Surgery.LaunchPad.NodaTime.HotChocolate.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\NodaTime.StrawberryShake\Rocket.Surgery.LaunchPad.NodaTime.StrawberryShake.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\Spatial\Rocket.Surgery.LaunchPad.Spatial.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\StrawberryShake\Rocket.Surgery.LaunchPad.StrawberryShake.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\StrawberryShake.Spatial\Rocket.Surgery.LaunchPad.StrawberryShake.Spatial.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\HotChocolate\Rocket.Surgery.LaunchPad.HotChocolate.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\Grpc\Rocket.Surgery.LaunchPad.Grpc.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\FluentValidation\Rocket.Surgery.LaunchPad.FluentValidation.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\FluentValidation.AspNetCore\Rocket.Surgery.LaunchPad.FluentValidation.AspNetCore.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\FluentValidation.Blazor\Rocket.Surgery.LaunchPad.FluentValidation.Blazor.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\FluentValidation.Grpc\Rocket.Surgery.LaunchPad.FluentValidation.Grpc.csproj" />
    <_LaunchPadSampleProject Include="$(MSBuildThisFileDirectory)..\..\..\src\FluentValidation.HotChocolate\Rocket.Surgery.LaunchPad.FluentValidation.HotChocolate.csproj" />
  </ItemGroup>

  <Target Name="Pack">
    <Error
      Text="global.json must pin Rocket.Surgery.LaunchPad.Sdk to '$(LaunchPadSampleVersion)' (the version this file packs)."
      Condition="!$(_LaunchPadSampleGlobalJson.Contains('&quot;$(LaunchPadSampleVersion)&quot;'))" />

    <ItemGroup>
      <_LaunchPadSampleStalePackage Include="$(LaunchPadSampleFeed)*.nupkg;$(LaunchPadSampleFeed)*.snupkg" />
      <_LaunchPadSampleStaleCacheDirectory Include="$([System.IO.Directory]::GetDirectories('$(LaunchPadSamplePackagesFolder)', 'rocket.surgery.launchpad*'))"
                                           Condition="Exists('$(LaunchPadSamplePackagesFolder)')" />
    </ItemGroup>
    <Delete Files="@(_LaunchPadSampleStalePackage)" />
    <RemoveDir Directories="@(_LaunchPadSampleStaleCacheDirectory)" />

    <!-- Restore separately (with a distinct global property) so Pack runs against a fresh evaluation. -->
    <MSBuild Projects="@(_LaunchPadSampleProject)" Targets="Restore" Properties="$(_LaunchPadSampleProperties);_LaunchPadSampleRestore=true" BuildInParallel="false" />
    <MSBuild Projects="@(_LaunchPadSampleProject)" Targets="Pack" Properties="$(_LaunchPadSampleProperties)" BuildInParallel="true" />

    <Message Importance="high" Text="LaunchPad packages $(LaunchPadSampleVersion) -> $(LaunchPadSampleFeed)" />
  </Target>
</Project>
