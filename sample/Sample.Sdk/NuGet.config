<?xml version="1.0" encoding="utf-8" ?>
<!--
    Self-contained on purpose: <clear /> drops the repository's own NuGet.config, so this sample restores packages the way an application
    outside the repository does: Rocket.Surgery.LaunchPad.* from the feed build/pack.proj packs into, everything else from nuget.org.
-->
<configuration>
    <config>
        <!--
            The packages are always packed at the same version (0.0.0-sample), so a shared ~/.nuget/packages would keep serving the first
            copy it restored. build/pack.proj clears the LaunchPad entries of this sample's own packages folder on every pack instead.
        -->
        <add key="globalPackagesFolder" value=".nuget/packages" />
    </config>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="launchpad-sample" value="../../artifacts/nuget-sample" />
    </packageSources>
    <packageSourceMapping>
        <clear />
        <packageSource key="launchpad-sample">
            <package pattern="Rocket.Surgery.LaunchPad.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
