<!--
    OutputType=Exe makes the SDK find a generic host: Dovetail adds Joinery.Dovetail.Hosting, which generates the ConfigureDovetail()
    extension Program.cs calls, and LaunchPad adds Rocket.Surgery.LaunchPad.Hosting, whose health check joint is written into the project
    because it references the health checks.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" />
  </ItemGroup>
</Project>
