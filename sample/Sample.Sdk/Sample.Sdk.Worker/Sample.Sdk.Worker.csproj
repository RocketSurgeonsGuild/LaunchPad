<!--
    Rocket.Surgery.LaunchPad.Sdk.Worker is Microsoft.NET.Sdk.Worker with LaunchPad, so it is the project's only SDK. It finds a generic host:
    Dovetail adds Joinery.Dovetail.Hosting, which generates the ConfigureDovetail() extension Program.cs calls, and LaunchPad adds
    Rocket.Surgery.LaunchPad.Hosting, whose health check joint is written into the project because it references the health checks.
-->
<Project Sdk="Rocket.Surgery.LaunchPad.Sdk.Worker/0.0.0-sample">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
  </ItemGroup>
</Project>
