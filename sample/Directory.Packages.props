<?xml version="1.0" encoding="utf-8" ?>
<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <AddSyntheticProjectReferencesForSolutionDependencies>false</AddSyntheticProjectReferencesForSolutionDependencies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Sample.AppHost. Keep them on the version of the Aspire CLI in .config/mise.toml, which the AppHost build resolves (ASPIRE009). -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Blazor" Version="17.0.0-preview.1.26567.5" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <!-- The identity provider of the samples (a preview integration, like the Blazor one) -->
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="17.0.0-preview.1.26567.5" />
  </ItemGroup>
</Project>
