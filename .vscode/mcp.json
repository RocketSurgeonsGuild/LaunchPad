{
  "servers": {
    "microsoftdocs/mcp": {
      "type": "sse",
      "url": "https://learn.microsoft.com/api/mcp",
      "headers": {}
    },
    "io.github.upstash/context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${input:context7-api-key}"
      }
    },
    "io.github.github/github-mcp-server": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "ghcr.io/github/github-mcp-server:1.4.0"
      ]
    },
    "nuget": {
      "type": "stdio",
      "command": "nuget-mcp-server",
      "args": []
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "context7-api-key",
      "description": "API key for authentication",
      "password": true
    }
  ]
}