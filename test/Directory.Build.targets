<Project>
    <!-- The test support project is a plain library: it is not a test project, so it skips the test framework packages. -->
    <ItemGroup Condition="'$(IsTestSupportProject)' != 'true'">
        <!--
            Every test project runs on TUnit with the Microsoft.Testing.Platform runner. TUnit brings its own coverage and TRX extensions, so
            a test project needs neither Microsoft.NET.Test.Sdk nor Microsoft.CodeCoverage.
        -->
        <PackageReference Include="TUnit" />
        <PackageReference Include="Verify.TUnit" />
        <PackageReference Include="Rocket.Surgery.Extensions.Testing.FakeItEasy" />
        <PackageReference Include="Rocket.Surgery.Extensions.Testing.TUnit" />
        <PackageReference Include="Bogus" />
        <PackageReference Include="FakeItEasy" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Verify.DiffPlex" />
        <PackageReference Include="Verify.NodaTime" />
        <PackageReference Include="Verify.SystemJson" />
        <PackageReference Include="Verify.NewtonsoftJson" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="JetBrains.Annotations.Sources" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup Condition="'$(IsTestSupportProject)' != 'true'">
        <PackageReference Include="Rocket.Surgery.Conventions" />
        <PackageReference Include="FakeItEasy.Analyzer.CSharp" />
        <Using Include="Rocket.Surgery.Extensions.Testing" />
        <Using Include="Bogus" />
        <Using Include="Shouldly" />
    </ItemGroup>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
</Project>
