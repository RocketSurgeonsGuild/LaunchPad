<Project>
    <!--
        Fixtures for test/Api.Functional.Tests: for each supported mediator a contracts project, a Minimal API server and an HTTP client, laid out
        the way an application would be. They are libraries, not test projects, so they import the repository's props directly instead of
        test/Directory.Build.props, which would add the test framework.
    -->
    <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <AnalysisMode>Default</AnalysisMode>
        <NoWarn>$(NoWarn);CA1812;CA1822;CA2007;CA1062;CA1034;CA1724</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/Api/Rocket.Surgery.LaunchPad.Api.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(ApiFunctionalRole)' == 'Server'">
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <PackageReference Include="protobuf-net.Grpc.AspNetCore" />
        <PackageReference Include="HotChocolate.AspNetCore" />
        <PackageReference Include="Asp.Versioning.Http" />
        <PackageReference Include="Asp.Versioning.Mvc" />
        <Compile Include="$(MSBuildThisFileDirectory)Shared/RocketStore.cs" Link="RocketStore.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(ApiFunctionalRole)' == 'ClientHost'">
        <PackageReference Include="Microsoft.Extensions.Http" />
    </ItemGroup>
    <ItemGroup Condition="'$(ApiFunctionalRole)' == 'GraphQLClientHost'">
        <PackageReference Include="Microsoft.Extensions.Http" />
    </ItemGroup>
    <ItemGroup Condition="'$(ApiFunctionalRole)' == 'GrpcClientHost'">
        <PackageReference Include="protobuf-net.Grpc.ClientFactory" />
    </ItemGroup>
    <ItemGroup Condition="'$(ApiFunctionalRole)' == 'Client' or '$(ApiFunctionalRole)' == 'ClientHost' or '$(ApiFunctionalRole)' == 'GrpcClientHost' or '$(ApiFunctionalRole)' == 'GraphQLClientHost'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)Abstractions/Api.Functional.Abstractions.csproj" />
    </ItemGroup>
</Project>
