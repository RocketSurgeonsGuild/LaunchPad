<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <UseDovetail>true</UseDovetail>

        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <GraphQLStrictSchemaValidation>true</GraphQLStrictSchemaValidation>
        <GraphQLClientStore>enable</GraphQLClientStore>
        <GraphQLRazorComponents>enable</GraphQLRazorComponents>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="System.Net.Http.Json" />

        <PackageReference Include="StrawberryShake.Transport.Http" />
        <PackageReference Include="StrawberryShake.Server" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\sample\Sample.Graphql\Sample.Graphql.csproj" />
        <ProjectReference
            Include="..\TestSupport\TestSupport.csproj" />
        <ProjectReference
            Include="..\..\src\StrawberryShake.Spatial\Rocket.Surgery.LaunchPad.StrawberryShake.Spatial.csproj" />
        <ProjectReference
            Include="..\..\src\StrawberryShake\Rocket.Surgery.LaunchPad.StrawberryShake.csproj" />
        <ProjectReference
            Include="..\..\src\NodaTime.StrawberryShake\Rocket.Surgery.LaunchPad.NodaTime.StrawberryShake.csproj" />
        <Using Include="StrawberryShake" />
    </ItemGroup>
    <!--
        The OpenAPI XML comment generator arrives with Microsoft.AspNetCore.OpenApi through the LaunchPad projects. It reads the XML documentation of
        every reference, which for the HotChocolate and Entity Framework packages is more than 24 MB of string literals (CS8103), and this test
        project documents no API.
    -->
    <Target Name="RemoveOpenApiXmlCommentGenerator" AfterTargets="ResolveLockFileAnalyzers">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
        </ItemGroup>
    </Target>
    <Target Name="DeleteGraphqlSchema" BeforeTargets="_GenerateGraphQLCode">
        <Delete
                Files="snapshots/FoundationTests.GraphqlSchema.received.txt"
                Condition="Exists('snapshots/FoundationTests.GraphqlSchema.received.txt')"
        />
        <Copy
                SourceFiles="snapshots/FoundationTests.GraphqlSchema.verified.txt"
                DestinationFiles="schema.graphql"
                Condition="Exists('snapshots/FoundationTests.GraphqlSchema.verified.txt')"
        />
    </Target>
</Project>
