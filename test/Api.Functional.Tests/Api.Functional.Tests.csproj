        -->
        <ProjectReference Include="../Api/Functional/Abstractions/Api.Functional.Abstractions.csproj" />
        <ProjectReference Include="../Api/Functional/MediatR/Api.Functional.MediatR.Server/Api.Functional.MediatR.Server.csproj" Aliases="mediatrserver" />
