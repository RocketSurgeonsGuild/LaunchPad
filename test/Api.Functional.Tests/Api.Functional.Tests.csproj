        <ProjectReference Include="../Api/Functional/ZeroAlloc/Api.Functional.ZeroAlloc.Client/Api.Functional.ZeroAlloc.Client.csproj" Aliases="zeroallocclient" />
        <ProjectReference Include="../Api/Functional/MediatR/Api.Functional.MediatR.GrpcClient/Api.Functional.MediatR.GrpcClient.csproj" Aliases="mediatrgrpcclient" />
