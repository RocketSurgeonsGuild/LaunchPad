<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ApiFunctionalRole>Contracts</ApiFunctionalRole>
        <!-- C# 15's union types come from Polyfill before .NET 11, embedded as the LaunchPad SDK sets it up (docs/design/union-types.md 3.3). -->
        <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
        <!-- The launch types' XML documentation describes their schemas in the OpenAPI document (the generators read the XML file). -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="ZeroAlloc.Mediator" />
        <!-- ScheduleLaunch's rules, which the generators state in the OpenAPI document. -->
        <PackageReference Include="ZeroAlloc.Validation" />
        <PackageReference Include="Polyfill" PrivateAssets="all" />
    </ItemGroup>
</Project>
