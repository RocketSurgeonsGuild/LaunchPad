<Project>
    <!--
        Fixtures for test/Api.Functional.Tests: for each supported mediator a contracts project and a server built by the generators, and in
        Clients/ the HTTP, gRPC and GraphQL clients generated from the servers' OpenAPI document, .proto and GraphQL schema. They are libraries, not test projects, so they import the repository's props directly instead of
        test/Directory.Build.props, which would add the test framework.
    -->
    <Import Project="$(MSBuildThisFileDirectory)../../../Directory.Build.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <AnalysisMode>Default</AnalysisMode>
        <NoWarn>$(NoWarn);CA1812;CA1822;CA2007;CA1062;CA1034;CA1724</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)../../../src/Api/Rocket.Surgery.LaunchPad.Api.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(ApiFunctionalRole)' == 'Server'">
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <PackageReference Include="protobuf-net.Grpc.AspNetCore" />
        <!-- GetProto() on the gRPC services: the .proto the gRPC client is generated from. -->
        <PackageReference Include="protobuf-net.Grpc.Reflection" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="HotChocolate.AspNetCore" />
        <PackageReference Include="Asp.Versioning.Http" />
        <PackageReference Include="Asp.Versioning.Mvc" />
        <Compile Include="$(MSBuildThisFileDirectory)Shared/RocketStore.cs" Link="RocketStore.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)Shared/FixtureOpenApi.cs" Link="FixtureOpenApi.cs" />
    </ItemGroup>
</Project>
