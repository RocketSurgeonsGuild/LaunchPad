<Project>
    <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.targets" />
    <!--
        Writes the specs before the client's code generator reads them (the exporter only rewrites a file that changed). It builds the project
        references first: StrawberryShake generates before BeforeBuild, ahead of the references, so the exporter might not be built yet.
    -->
    <Target Name="ExportApiSpecs" BeforeTargets="$(ExportApiSpecsBeforeTargets)" DependsOnTargets="ResolveProjectReferences" Condition="'$(ExportApiSpecsBeforeTargets)' != ''">
        <MSBuild Projects="$(MSBuildThisFileDirectory)Api.Functional.SpecExport/Api.Functional.SpecExport.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" PropertyName="_ApiSpecExporter" />
        </MSBuild>
        <PropertyGroup>
            <_ApiSpecDotnet>$(DOTNET_HOST_PATH)</_ApiSpecDotnet>
            <_ApiSpecDotnet Condition="'$(_ApiSpecDotnet)' == ''">dotnet</_ApiSpecDotnet>
        </PropertyGroup>
        <Exec Command="&quot;$(_ApiSpecDotnet)&quot; &quot;$(_ApiSpecExporter)&quot; &quot;$(ApiSpecDirectory)&quot;" StandardOutputImportance="low" StandardErrorImportance="high" />
    </Target>
</Project>
