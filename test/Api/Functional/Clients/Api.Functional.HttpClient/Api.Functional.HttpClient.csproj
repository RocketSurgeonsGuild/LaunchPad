<Project Sdk="Microsoft.NET.Sdk">
    <Sdk Name="Chirograph" />
    <!--
        The HTTP client Kiota generates from the servers' OpenAPI document, through Chirograph's OpenApiClient item; the exporter writes the
        document before Chirograph checks it. Chirograph's public hook, ChirographGenerateOpenApiClients, generates in its DependsOnTargets,
        which MSBuild runs before the targets that are BeforeTargets of it, so the exporter hooks the first step instead.
    -->
    <PropertyGroup>
        <ExportApiSpecsBeforeTargets>_ChirographCheckOpenApiClients</ExportApiSpecsBeforeTargets>
        <ApiSpecDirectory>$(ApiFunctionalSpecs)</ApiSpecDirectory>
    </PropertyGroup>
    <ItemGroup>
        <!-- not under the root namespace: Kiota writes the /api path as an Api namespace, which Dovetail's generated exports would resolve Api.Functional against -->
        <OpenApiClient Include="$(ApiFunctionalSpecs)openapi.json" Generator="Kiota" ClientName="RocketsClient" Namespace="Api.Functional.Clients.Http" />
    </ItemGroup>
    <ItemGroup>
        <!-- what Chirograph adds for a Kiota client, referenced here so central package management gives the versions (NU1009) -->
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Kiota.Bundle" />
    </ItemGroup>
</Project>
