<Project Sdk="Microsoft.NET.Sdk">
    <!--
        The HTTP client Kiota generates from the servers' OpenAPI document, through the LaunchPad SDK's OpenApiClient item. The SDK's targets
        are imported directly, as the repository builds against its own projects rather than the packed SDK; the exporter writes the
        document before the client is prepared.
    -->
    <PropertyGroup>
        <ExportApiSpecsBeforeTargets>_LaunchPadPrepareOpenApiClients</ExportApiSpecsBeforeTargets>
        <ApiSpecDirectory>$(ApiFunctionalSpecs)</ApiSpecDirectory>
    </PropertyGroup>
    <ItemGroup>
        <!-- not under the root namespace: Kiota writes the /api path as an Api namespace, which Dovetail's generated exports would resolve Api.Functional against -->
        <OpenApiClient Include="$(ApiFunctionalSpecs)openapi.json" Generator="Kiota" ClientName="RocketsClient" Namespace="Api.Functional.Clients.Http" />
    </ItemGroup>
    <ItemGroup>
        <!-- what the packed SDK adds for a Kiota client, and the joint it generates -->
        <PackageReference Include="Joinery.Dovetail" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Kiota.Bundle" />
        <!-- the Kiota tool, at the version Directory.Packages.props pins (the packed SDK writes it into LaunchPadKiotaVersion) -->
        <PackageDownload Include="@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.OpenApi.Kiota'))" Version="[%(Version)]" />
    </ItemGroup>
    <Import Project="$(MSBuildThisFileDirectory)../../../../../src/Sdk/Sdk/Rocket.Surgery.LaunchPad.OpenApiClients.targets" />
</Project>
