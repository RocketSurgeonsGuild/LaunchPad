<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup>
        <!-- martinothamar/Mediator only dispatches to handlers its own generator finds, so the generated client handlers live in a library
             that does not run that generator; the application does, and finds them as metadata. -->
        <ProjectReference Include="../Api.Aot.Contracts/Api.Aot.Contracts.csproj" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <ProjectReference Include="../../../../src/Api/Rocket.Surgery.LaunchPad.Api.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
