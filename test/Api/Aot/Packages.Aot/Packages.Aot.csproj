<Project Sdk="Microsoft.NET.Sdk.Web">
    <!--
        The native AOT check for LaunchPad's native AOT compatible packages (ASP.NET Core, gRPC, StrawberryShake, NodaTime, Spatial and Foundation): published with PublishAot and
        every LaunchPad assembly rooted, so ILLink analyzes all of their code, not only what Program.cs reaches. verify.sh fails on a warning
        in a LaunchPad assembly and on a dependency warning docs/src/content/docs/guides/json-and-native-aot.md doesn't list.
    -->
    <PropertyGroup>
        <PublishAot>true</PublishAot>
        <!-- One IL2104 per dependency that has trim warnings, rather than each of them: the dependencies are listed by assembly. -->
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
        <!--
            The trimming and AOT warnings this publish collects are its output, not failures: verify.sh fails on every warning
            dependency-warnings.txt doesn't list, so the listed ones (NetTopologySuite.IO.GeoJSON4STJ's IL2104/IL3053) stay warnings here.
        -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../../../src/AspNetCore/Rocket.Surgery.LaunchPad.AspNetCore.csproj" />
        <ProjectReference Include="../../../../src/Grpc/Rocket.Surgery.LaunchPad.Grpc.csproj" />
        <ProjectReference Include="../../../../src/StrawberryShake/Rocket.Surgery.LaunchPad.StrawberryShake.csproj" />
        <ProjectReference Include="../../../../src/NodaTime/Rocket.Surgery.LaunchPad.NodaTime.csproj" />
        <ProjectReference Include="../../../../src/Spatial/Rocket.Surgery.LaunchPad.Spatial.csproj" />
    </ItemGroup>
    <ItemGroup>
        <TrimmerRootAssembly Include="Rocket.Surgery.LaunchPad.AspNetCore" />
        <TrimmerRootAssembly Include="Rocket.Surgery.LaunchPad.Grpc" />
        <TrimmerRootAssembly Include="Rocket.Surgery.LaunchPad.StrawberryShake" />
        <TrimmerRootAssembly Include="Rocket.Surgery.LaunchPad.Foundation" />
        <TrimmerRootAssembly Include="Rocket.Surgery.LaunchPad.NodaTime" />
        <TrimmerRootAssembly Include="Rocket.Surgery.LaunchPad.Spatial" />
    </ItemGroup>
</Project>
