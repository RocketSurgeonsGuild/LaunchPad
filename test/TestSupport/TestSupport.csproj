<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
        <!-- Test support for this repository only: nothing in here ships to NuGet, and it is a library, not a test project. -->
        <IsPackable>false</IsPackable>
        <IsTestSupportProject>true</IsTestSupportProject>
        <!--
            test/Directory.Build.props marks everything under test/ as a test project, but this one is a library: Dovetail exports the joints
            of a library (FakeTimeJoint and the web fixtures' joints) and only imports them into a test project, so as a test project the
            joints never reached the test applications.
        -->
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <!-- fake time -->
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="NodaTime.Testing" />
        <PackageReference Include="Joinery.Dovetail" />
        <!-- web application fixtures -->
        <PackageReference Include="Alba" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    </ItemGroup>
    <ItemGroup>
        <!--
            Only Foundation and NodaTime: FakeTimeJoint orders itself before TimeJoint, which the NodaTime package owns. The web fixtures
            need no LaunchPad project (the old AspNetCore.Testing package referenced AspNetCore and Serilog, but every web sample test
            already gets those through its sample and Foundation). Referencing AspNetCore here would also hand its joints to the six
            projects that only use fake time.
        -->
        <ProjectReference Include="..\..\src\NodaTime\Rocket.Surgery.LaunchPad.NodaTime.csproj" />
        <ProjectReference Include="..\..\src\Foundation\Rocket.Surgery.LaunchPad.Foundation.csproj" />
    </ItemGroup>
</Project>
