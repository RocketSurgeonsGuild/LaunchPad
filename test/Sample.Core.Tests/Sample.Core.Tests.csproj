<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\sample\Sample.Core\Sample.Core.csproj" />
        <ProjectReference Include="..\TestSupport\TestSupport.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../Shared/ContainerTest.cs" Link="Shared/ContainerTest.cs" />
        <Using Include="Rocket.Surgery.LaunchPad.Testing" />
    </ItemGroup>
    <!--
        The strong IDs of Sample.Core are domain primitives, which an application stores through the Entity Framework joint of
        LaunchPad.Primitives. These tests bring their own database instead of the application's, and a test project is no host, so it gets
        none of the Primitives templates: it takes the registry and the Entity Framework joint itself, with the generator that fills the
        registry in. Dovetail exports a test project's own joints for the unit test host only, so the joint configures the database of the
        unit test host; DataGenerationJointTests, which runs the live host, calls LaunchPadPrimitives.ConfigureDbContexts itself.
    -->
    <ItemGroup>
        <ProjectReference
            Include="..\..\src\Primitives.Analyzers\Rocket.Surgery.LaunchPad.Primitives.Analyzers.csproj"
            PrivateAssets="all"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>
    <Target Name="AddPrimitivesEntityFrameworkJoint" AfterTargets="DovetailResolveTemplates" BeforeTargets="DovetailGenerateTemplates">
        <ItemGroup>
            <DovetailEmittedTemplate
                Include="@(DovetailTemplate)"
                Condition="'%(Identity)' == 'LaunchPadPrimitives' or '%(Identity)' == 'LaunchPadPrimitivesEntityFrameworkJoint'"
            />
        </ItemGroup>
    </Target>
</Project>
