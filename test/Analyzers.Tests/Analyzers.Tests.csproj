<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
        <DefineConstants>$(DefineConstants);ROSLYN_CURRENT;ROSLYN4_8</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <!-- The explicit generator benchmarks share their harness. -->
        <Compile Include="../Shared/GeneratorBenchmark.cs" Link="Shared/GeneratorBenchmark.cs" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Common" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Features" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" PrivateAssets="all" />
        <!-- the version the analyzer assembly compiles against (MSB3277 otherwise) -->
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
        <ProjectReference Include="..\..\src\Analyzers\Rocket.Surgery.LaunchPad.Analyzers.csproj" />
        <ProjectReference Include="..\..\src\Foundation.Tasks\Rocket.Surgery.LaunchPad.Foundation.Tasks.csproj" />
        <ProjectReference Include="..\..\src\AspNetCore\Rocket.Surgery.LaunchPad.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\Foundation\Rocket.Surgery.LaunchPad.Foundation.csproj" />
        <PackageReference Include="Rocket.Surgery.Extensions.Testing.SourceGenerators" />
        <PackageReference Include="Verify.SourceGenerators" />
        <!-- the request interfaces the test sources implement, one library per built-in mediator profile; none of their generators run here -->
        <PackageReference Include="ZeroAlloc.Mediator" />
        <PackageReference Include="Mediator.Abstractions" />
        <PackageReference Include="ChannelMediator" />
        <PackageReference Include="Foundatio.Mediator.Abstractions" />
        <PackageReference Include="Immediate.Handlers" IncludeAssets="compile;runtime" />
        <!-- ValidatorFor<T>, for the validator the Mutable generator writes; its generator doesn't run here -->
        <PackageReference Include="ZeroAlloc.Validation" IncludeAssets="compile;runtime" />
        <ProjectReference
            Include="..\..\src\HotChocolate\Rocket.Surgery.LaunchPad.HotChocolate.csproj" />
    </ItemGroup>

</Project>