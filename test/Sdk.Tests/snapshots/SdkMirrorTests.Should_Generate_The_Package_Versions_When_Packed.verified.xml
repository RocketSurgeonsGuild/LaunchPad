<Project>
<!-- Generated when {PackageId} is packed. Each version is only set when the application has not set it already. -->
<PropertyGroup>
<LaunchPadDovetailSdkVersion Condition="'$(LaunchPadDovetailSdkVersion)' == ''">{DovetailVersion}</LaunchPadDovetailSdkVersion>
<LaunchPadChirographVersion Condition="'$(LaunchPadChirographVersion)' == ''">{ChirographVersion}</LaunchPadChirographVersion>
<LaunchPadVersion Condition="'$(LaunchPadVersion)' == ''">{LaunchPadVersion}</LaunchPadVersion>
</PropertyGroup>
</Project>
