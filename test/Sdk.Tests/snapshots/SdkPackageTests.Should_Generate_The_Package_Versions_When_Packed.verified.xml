<LaunchPadHostingVersion Condition="'$(LaunchPadHostingVersion)' == ''">{LaunchPadVersion}</LaunchPadHostingVersion>
<LaunchPadSerilogAspNetCoreVersion Condition="'$(LaunchPadSerilogAspNetCoreVersion)' == ''">{LaunchPadVersion}</LaunchPadSerilogAspNetCoreVersion>
<LaunchPadFluentValidationVersion Condition="'$(LaunchPadFluentValidationVersion)' == ''">{LaunchPadVersion}</LaunchPadFluentValidationVersion>
<LaunchPadFluentValidationAspNetCoreVersion Condition="'$(LaunchPadFluentValidationAspNetCoreVersion)' == ''">{LaunchPadVersion}</LaunchPadFluentValidationAspNetCoreVersion>
<LaunchPadFluentValidationBlazorVersion Condition="'$(LaunchPadFluentValidationBlazorVersion)' == ''">{LaunchPadVersion}</LaunchPadFluentValidationBlazorVersion>
<LaunchPadFluentValidationGrpcVersion Condition="'$(LaunchPadFluentValidationGrpcVersion)' == ''">{LaunchPadVersion}</LaunchPadFluentValidationGrpcVersion>
<LaunchPadFluentValidationHotChocolateVersion Condition="'$(LaunchPadFluentValidationHotChocolateVersion)' == ''">{LaunchPadVersion}</LaunchPadFluentValidationHotChocolateVersion>
</PropertyGroup>
</Project>
