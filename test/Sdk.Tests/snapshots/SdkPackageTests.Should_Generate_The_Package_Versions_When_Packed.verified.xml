<Project>
<!-- Generated when Rocket.Surgery.LaunchPad.Sdk is packed. Each version is only set when the application has not set it already. -->
<PropertyGroup>
<LaunchPadDovetailSdkVersion Condition="'$(LaunchPadDovetailSdkVersion)' == ''">{DovetailVersion}</LaunchPadDovetailSdkVersion>
<LaunchPadChirographVersion Condition="'$(LaunchPadChirographVersion)' == ''">{ChirographVersion}</LaunchPadChirographVersion>
<LaunchPadVersion Condition="'$(LaunchPadVersion)' == ''">{LaunchPadVersion}</LaunchPadVersion>
<LaunchPadOpenTelemetryExporterVersion Condition="'$(LaunchPadOpenTelemetryExporterVersion)' == ''">{Pinned}</LaunchPadOpenTelemetryExporterVersion>
<LaunchPadOpenTelemetryHttpInstrumentationVersion Condition="'$(LaunchPadOpenTelemetryHttpInstrumentationVersion)' == ''">{Pinned}</LaunchPadOpenTelemetryHttpInstrumentationVersion>
<LaunchPadOpenTelemetryRuntimeInstrumentationVersion Condition="'$(LaunchPadOpenTelemetryRuntimeInstrumentationVersion)' == ''">{Pinned}</LaunchPadOpenTelemetryRuntimeInstrumentationVersion>
<LaunchPadOpenTelemetryProcessInstrumentationVersion Condition="'$(LaunchPadOpenTelemetryProcessInstrumentationVersion)' == ''">{Pinned}</LaunchPadOpenTelemetryProcessInstrumentationVersion>
<LaunchPadOpenTelemetryAspNetCoreInstrumentationVersion Condition="'$(LaunchPadOpenTelemetryAspNetCoreInstrumentationVersion)' == ''">{Pinned}</LaunchPadOpenTelemetryAspNetCoreInstrumentationVersion>
<LaunchPadSerilogOpenTelemetryVersion Condition="'$(LaunchPadSerilogOpenTelemetryVersion)' == ''">{Pinned}</LaunchPadSerilogOpenTelemetryVersion>
</PropertyGroup>
</Project>
