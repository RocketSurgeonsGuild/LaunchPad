{
  "parameters": {
    "/customers/{id}": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/CustomerId"
        }
      },
      {
        "name": "email",
        "in": "query",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/CustomerEmail"
        }
      },
      {
        "name": "rating",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/Rating"
        }
      }
    ],
    "/customers/{id}/rating": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/CustomerId"
        }
      },
      {
        "name": "country",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/CountryCode"
        }
      }
    ]
  },
  "schemas": {
    "CountryCode": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
    },
    "CurrencyCode": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "Customer": {
      "required": [
        "id",
        "email",
        "country",
        "rating",
        "balance"
      ],
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/components/schemas/CustomerId"
        },
        "email": {
          "$ref": "#/components/schemas/CustomerEmail"
        },
        "country": {
          "$ref": "#/components/schemas/CountryCode"
        },
        "rating": {
          "$ref": "#/components/schemas/Rating"
        },
        "balance": {
          "$ref": "#/components/schemas/Money"
        },
        "membership": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/components/schemas/DateRange"
            }
          ]
        },
        "handle": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/components/schemas/Slug"
            }
          ]
        }
      }
    },
    "CustomerEmail": {
      "maxLength": 254,
      "pattern": "^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$",
      "type": "string",
      "format": "email"
    },
    "CustomerId": {
      "type": "string",
      "format": "uuid"
    },
    "DateRange": {
      "required": [
        "start",
        "end"
      ],
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "Money": {
      "required": [
        "amount",
        "currency"
      ],
      "type": "object",
      "properties": {
        "amount": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": [
            "number",
            "string"
          ],
          "format": "double"
        },
        "currency": {
          "$ref": "#/components/schemas/CurrencyCode"
        }
      }
    },
    "Rating": {
      "maximum": 5,
      "minimum": 1,
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": [
        "integer",
        "string"
      ],
      "format": "int32"
    },
    "Slug": {
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    }
  }
}
