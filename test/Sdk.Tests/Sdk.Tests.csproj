<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!--
            MSBuild.ProjectCreation loads MSBuild from an installed SDK of the test host's major version, and global.json pins the SDK of
            the newest target framework, so the host runs on that one. The throwaway projects cover every target framework instead, through
            TargetFrameworksAttribute, as in Dovetail's SDK tests.
        -->
        <TargetFramework>$(LaunchPadLatestTargetFramework)</TargetFramework>
        <!--
            The tests pack Rocket.Surgery.LaunchPad.Sdk and Rocket.Surgery.LaunchPad.Hosting and build throwaway applications that apply the
            SDK the way an application outside this repository does, so the project references nothing of LaunchPad itself.
        -->
    </PropertyGroup>
    <ItemGroup>
        <!-- writes the throwaway projects, their global.json and their package repository -->
        <PackageReference Include="MSBuild.ProjectCreation" />
    </ItemGroup>
    <ItemGroup>
        <!-- running dotnet is what the Hosting tests do as well -->
        <Compile Include="../Hosting.Tests/Scaffolding/DotnetCli.cs" Link="Scaffolding/DotnetCli.cs" />
        <!-- the pinned package versions and the target frameworks, read as the Hosting tests read them -->
        <Compile Include="../Hosting.Tests/Scaffolding/PinnedPackages.cs" Link="Scaffolding/PinnedPackages.cs" />
    </ItemGroup>
</Project>
