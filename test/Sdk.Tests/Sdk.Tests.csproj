<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!--
            MSBuild.ProjectCreation loads MSBuild from an installed SDK of the test host's major version, and SDK 11 is the only one mise
            installs (with just the .NET 10 runtime). The throwaway projects cover both target frameworks instead, through
            TargetFrameworksAttribute, as in Dovetail's SDK tests.
        -->
        <TargetFramework>net11.0</TargetFramework>
        <!--
            The tests pack Rocket.Surgery.LaunchPad.Sdk and Rocket.Surgery.LaunchPad.Hosting and build throwaway applications that apply the
            SDK the way an application outside this repository does, so the project references nothing of LaunchPad itself. It takes the
            Dovetail wiring like every converted test project (RocketSurgeonsGuild/LaunchPad#3056 deletes the property).
        -->
        <UseDovetail>true</UseDovetail>
    </PropertyGroup>
    <ItemGroup>
        <!-- writes the throwaway projects, their global.json and their package repository -->
        <PackageReference Include="MSBuild.ProjectCreation" />
    </ItemGroup>
    <ItemGroup>
        <!-- running dotnet is what the Hosting tests do as well -->
        <Compile Include="../Hosting.Tests/Scaffolding/DotnetCli.cs" Link="Scaffolding/DotnetCli.cs" />
    </ItemGroup>
</Project>
