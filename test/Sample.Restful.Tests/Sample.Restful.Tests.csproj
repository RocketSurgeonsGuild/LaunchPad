<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Chirograph" />
  <PropertyGroup>
    <TargetFrameworks>$(LaunchPadTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="System.Net.Http.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\sample\Sample.Restful\Sample.Restful.csproj" />
    <ProjectReference
      Include="..\TestSupport\TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the Refit client Chirograph generates from the document the sample writes when it builds -->
    <OpenApiClient Include="..\..\sample\Sample.Restful\Sample.Restful.csproj" Generator="Refitter" ClientName="SampleClient" Namespace="Sample.Restful.Tests.Client" />
    <!-- what Chirograph adds for a Refitter client, referenced here so central package management gives the version (NU1009) -->
    <PackageReference Include="Refit.HttpClientFactory" />
    <!-- a global using rather than one in each file: the generated code only exists after a build, so dotnet format (a design-time build) sees the namespace as unused and removes a using in a file -->
    <Using Include="Sample.Restful.Tests.Client" />
  </ItemGroup>
</Project>