<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="System.Net.Http.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\sample\Sample.Minimal\Sample.Minimal.csproj" />
    <ProjectReference
      Include="..\TestSupport\TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the Refit client the LaunchPad SDK generates from the document the sample writes when it builds -->
    <OpenApiClient Include="..\..\sample\Sample.Minimal\Sample.Minimal.csproj" Generator="Refitter" ClientName="SampleClient" Namespace="Sample.Minimal.Tests.Client" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <!-- a global using rather than one in each file: the generated code only exists after a build, so dotnet format (a design-time build) sees the namespace as unused and removes a using in a file -->
    <Using Include="Sample.Minimal.Tests.Client" />
  </ItemGroup>
  <Import Project="..\OpenApiClients.targets" />
</Project>
