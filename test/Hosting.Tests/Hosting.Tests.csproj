<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <!--
            The test application is an executable. TUnit's package targets say so too, but restore doesn't see them, so without this a restore
            of this project alone skips the net10.0 apphost pack (the SDK only carries its own version's) and the build then fails with
            MSB3030 on obj/Release/net10.0/apphost. In a build of the whole solution another project downloads the pack first.
        -->
        <OutputType>Exe</OutputType>
        <!--
            The tests pack Rocket.Surgery.LaunchPad.Hosting and build throwaway applications against the package, so the project references
            nothing of LaunchPad itself.
        -->
    </PropertyGroup>
    <ItemGroup>
        <!-- Dovetail emits the lifecycle helpers (OnHostStarted and so on) into a project that references both of these -->
        <PackageReference Include="Joinery.Dovetail.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>
    <ItemGroup>
        <!-- the snapshot of the C# a template writes into an application is C# too, and not part of this project -->
        <Compile Remove="snapshots/**" />
        <None Include="snapshots/**" />
    </ItemGroup>
</Project>
