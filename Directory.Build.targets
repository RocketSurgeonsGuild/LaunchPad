<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <!--
        Each project's generated AssemblyInfo class lives in a namespace named after its assembly, the one name no two projects share (two can
        share a RootNamespace: Rocket.Surgery.LaunchPad.AspNetCore and Rocket.Surgery.LaunchPad.FluentValidation.AspNetCore do). In a shared
        namespace a project that sees another's internals (a test through InternalsVisibleTo) binds typeof(AssemblyInfo) to the wrong copy, or
        to two, and Specular, which can anchor an assembly with that type, scans the wrong one or fails to compile.
    -->
    <PropertyGroup>
        <AssemblyInfoNamespace Condition="'$(AssemblyInfoNamespace)' == ''">$(AssemblyName)</AssemblyInfoNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations.Sources" PrivateAssets="all" />
    </ItemGroup>
    <!--
        The templates of LaunchPad.Hosting are declared in the targets the package ships, which NuGet imports into a project that references
        the package. A ProjectReference imports no package assets, and the samples and tests reference Hosting that way, so the targets are
        imported into every project here. They write a template into a project that has a direct reference to Hosting and meets the
        template's other gates, and into no other (src/Hosting/build/Rocket.Surgery.LaunchPad.Hosting.targets).
    -->
    <Import Project="$(MSBuildThisFileDirectory)src/Hosting/build/Rocket.Surgery.LaunchPad.Hosting.targets" />
</Project>
