<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <!--
        Each project's generated AssemblyInfo class lives in its own root namespace (set here, after the SDK has defaulted RootNamespace).
        In the global namespace every project would have the same AssemblyInfo, so a project that sees another's internals (a test through
        InternalsVisibleTo) would bind typeof(AssemblyInfo) to its own copy, and Specular, which can anchor an assembly with that type,
        would scan the wrong one.
    -->
    <PropertyGroup>
        <AssemblyInfoNamespace Condition="'$(AssemblyInfoNamespace)' == ''">$(RootNamespace)</AssemblyInfoNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations.Sources" PrivateAssets="all" />
    </ItemGroup>
    <!--
        The templates of LaunchPad.Hosting are declared in the targets the package ships, which NuGet imports into a project that references
        the package. A ProjectReference imports no package assets, and the samples and tests reference Hosting that way, so the targets are
        imported into every project here. They write a template into a project that has a direct reference to Hosting and meets the
        template's other gates, and into no other (src/Hosting/build/Rocket.Surgery.LaunchPad.Hosting.targets).
    -->
    <Import Project="$(MSBuildThisFileDirectory)src/Hosting/build/Rocket.Surgery.LaunchPad.Hosting.targets" />
</Project>
