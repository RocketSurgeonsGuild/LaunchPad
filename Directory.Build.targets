<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <!--
        Each project's generated AssemblyInfo class lives in a namespace named after its assembly, the one name no two projects share (two can
        share a RootNamespace: Rocket.Surgery.LaunchPad.AspNetCore and Rocket.Surgery.LaunchPad.FluentValidation.AspNetCore do). In a shared
        namespace a project that sees another's internals (a test through InternalsVisibleTo) binds typeof(AssemblyInfo) to the wrong copy, or
        to two, and Specular, which can anchor an assembly with that type, scans the wrong one or fails to compile.
    -->
    <PropertyGroup>
        <AssemblyInfoNamespace Condition="'$(AssemblyInfoNamespace)' == ''">$(AssemblyName)</AssemblyInfoNamespace>
    </PropertyGroup>
    <!--
        On CI, skip Verify's sponsor check, whose result the OpenSource exemption in test/Directory.Build.props already settles. Before
        BeforeBuild of every test project's inner build it calls MSBuild on each project reference (and their references) without removing
        TargetFramework, and those calls queue behind nodes busy compiling (12,226 s of waiting in the solution build of run 43488163702).
        ContinuousIntegrationBuild comes from Rocket.Surgery.MSBuild.CI's props, which NuGet imports after Directory.Build.props, so the
        condition is read here. Local builds still run the check. The suffix is Verify's hash of its package id; if Verify renames the property,
        this stops applying (and the build gets slower again, nothing else).
    -->
    <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
        <_SponsorCheck_OwnerVerified_Verify_eea2745e>true</_SponsorCheck_OwnerVerified_Verify_eea2745e>
    </PropertyGroup>
    <!--
        The templates of LaunchPad.Hosting are declared in the targets the package ships, which NuGet imports into a project that references
        the package. A ProjectReference imports no package assets, and the samples and tests reference Hosting that way, so the targets are
        imported into every project here. They write a template into a project that has a direct reference to Hosting and meets the
        template's other gates, and into no other (src/Hosting/build/Rocket.Surgery.LaunchPad.Hosting.targets).
    -->
    <Import Project="$(MSBuildThisFileDirectory)src/Hosting/build/Rocket.Surgery.LaunchPad.Hosting.targets" />
    <!--
        The templates of LaunchPad.Primitives, for the same reason: written into a project with a direct reference to Primitives that meets the
        template's other gates (src/Primitives/build/Rocket.Surgery.LaunchPad.Primitives.Templates.targets). Only the templates: the rest of
        Primitives' targets is for the projects that reference the package.
    -->
    <Import
        Project="$(MSBuildThisFileDirectory)src/Primitives/build/Rocket.Surgery.LaunchPad.Primitives.Templates.targets"
        Condition="'$(_LaunchPadPrimitivesTemplatesImported)' != 'true'"
    />
    <!--
        The same for LaunchPad.Foundation, whose targets write an executable's JSON context with the task of src/Foundation.Tasks. Here the task
        comes from that project's output instead of the package's tasks folder; every project that writes a context builds it first.
    -->
    <PropertyGroup>
        <LaunchPadFoundationTasksAssembly>$(MSBuildThisFileDirectory)src/Foundation.Tasks/bin/$(Configuration)/netstandard2.0/Rocket.Surgery.LaunchPad.Foundation.Tasks.dll</LaunchPadFoundationTasksAssembly>
    </PropertyGroup>
    <Import Project="$(MSBuildThisFileDirectory)src/Foundation/build/Rocket.Surgery.LaunchPad.Foundation.JsonContext.targets" />
    <!-- Every project that writes a JSON context builds the task first, whatever order the solution builds in. -->
    <ItemGroup Condition="'$(LaunchPadGenerateJsonContext)' == 'true'">
        <ProjectReference
            Include="$(MSBuildThisFileDirectory)src/Foundation.Tasks/Rocket.Surgery.LaunchPad.Foundation.Tasks.csproj"
            PrivateAssets="all"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>
    <!--
        On CI, have the compiler time every analyzer and source generator. The times are in the build binlog (artifacts/logs, uploaded
        as an artifact): the Structured Log Viewer shows them under each Csc task, or replay it with -flp:v=diag and look for
        "Total analyzer execution time" and "Total generator execution time".
    -->
    <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
        <ReportAnalyzer>true</ReportAnalyzer>
    </PropertyGroup>
</Project>
