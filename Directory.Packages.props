<?xml version="1.0" encoding="utf-8"?>

<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <GlobalPackageReference Include="Rocket.Surgery.AssemblyInfo" Version="2026.11.4" />
        <GlobalPackageReference Include="ZeroAlloc.Analyzers" Version="1.13.1" />
        <GlobalPackageReference Include="JetBrains.ExternalAnnotations" Version="10.2.172" />
    </ItemGroup>
    <ItemGroup>

    <!--
        The SDK injects this analyzer as an implicit reference, which cannot also have a PackageVersion (NU1009). Hosting.Tests reads this
        pin to scaffold throwaway apps; keep it in step with the SDK's version.
    -->
    <SdkPinnedPackage Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Rocket.Surgery.ModularPipelines.Extensions" Version="0.2.3" />
    <!--
        build/Build.cs references it directly, so its generator writes ConfigureDovetail(); the version Rocket.Surgery.ModularPipelines.Extensions
        needs. It stays on 0.5.3 while the rest of the repository is on Dovetail 0.7.0: Extensions 0.2.3 is built against Dovetail 0.5.3 and calls
        DovetailConfigurationOptionsExtensions, which 0.7.0 removed (TypeLoadException when the build host starts). Move it with Extensions.
    -->
    <PackageVersion Include="Joinery.Dovetail.ModularPipelines" Version="0.7.0" />
    <PackageVersion Include="Sourcy.DotNet" Version="1.1.1" />
    <PackageVersion Include="Sourcy.Git" Version="1.1.1" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />

        <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.20.1-rc.1" />

        <PackageVersion Include="Serilog.Enrichers.AssemblyName" Version="2.0.0" />
        <PackageVersion Include="Serilog.Enrichers.Demystifier" Version="1.0.3" />
        <PackageVersion Include="Serilog.Sinks.ApplicationInsights" Version="5.0.1" />
        <PackageVersion Include="Serilog.Sinks.BrowserConsole" Version="8.0.0" />
        <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.1-nblumhardt-02317" />

        <PackageVersion Include="Serilog.Sinks.Trace" Version="4.0.0" />
        <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
        <PackageVersion Include="Verify.DiffPlex" Version="3.4.0" />


        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
        <PackageVersion Include="Polyfill" Version="11.4.5" />
        <PackageVersion Include="SuperStrong.Types" Version="1.0.0" />

        <PackageVersion Include="ZeroAlloc.Mediator" Version="6.7.2" />
        <PackageVersion Include="ZeroAlloc.Mediator.Generator" Version="6.7.2" />
        <PackageVersion Include="ZeroAlloc.Mediator.Validation" Version="6.7.2" />
        <!-- Maps proto messages to and from requests and responses on proto-first gRPC hosts (approved 2026-11-08). -->
        <PackageVersion Include="ZeroAlloc.Mapping" Version="1.7.1" />
        <PackageVersion Include="ZeroAlloc.Validation" Version="2.6.1" />
        <PackageVersion Include="ZeroAlloc.Validation.Inject" Version="2.6.1" />
        <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
        <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
        <PackageVersion Include="Joinery.Dovetail.Serilog" Version="0.7.0" />
        <PackageVersion Include="HotChocolate" Version="16.7.6" />

        <PackageVersion Include="HotChocolate.AspNetCore" Version="16.7.6" />
        <PackageVersion Include="HotChocolate.Data" Version="16.7.6" />
        <PackageVersion Include="HotChocolate.Diagnostics" Version="16.7.6" />
        <PackageVersion Include="HotChocolate.Execution.Abstractions" Version="16.7.6" />

        <PackageVersion Include="HotChocolate.Data.Spatial" Version="16.7.6" />
        <PackageVersion Include="HotChocolate.Types.Analyzers" Version="16.7.6" />
        <PackageVersion Include="HotChocolate.Types.CursorPagination" Version="16.7.6" />
        <PackageVersion Include="HotChocolate.Types.OffsetPagination" Version="16.7.6" />
        <PackageVersion Include="HotChocolate.Types.NodaTime" Version="16.7.6" />
        <PackageVersion Include="HotChocolate.Types.Spatial" Version="16.7.6" />
        <PackageVersion Include="StrawberryShake.Transport.Http" Version="16.7.6" />

        <PackageVersion Include="StrawberryShake.Core" Version="16.7.6" />
        <PackageVersion Include="StrawberryShake.Server" Version="16.7.6" />


        <!-- Mediators the API generators support; used by their tests and samples. -->
        <PackageVersion Include="ChannelMediator" Version="1.1.21" />
        <PackageVersion Include="Foundatio.Mediator" Version="1.3.3" />
        <PackageVersion Include="Foundatio.Mediator.Abstractions" Version="1.3.3" />
        <PackageVersion Include="Immediate.Handlers" Version="4.3.0" />
        <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
        <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
        <!-- Code-first gRPC for the API generators' gRPC transport; used by their tests. -->
        <PackageVersion Include="protobuf-net.Grpc.AspNetCore" Version="1.3.14" />
        <PackageVersion Include="protobuf-net.Grpc.Reflection" Version="1.3.14" />
        <!-- API versioning for the API generators' Minimal API and controller hosts; used by their tests. -->
        <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
        <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />






        <!-- Compiled against only: the JSON context task (src/Primitives.Tasks) runs inside MSBuild, which brings both. -->
        <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.12.2" />
        <PackageVersion Include="System.Reflection.Metadata" Version="11.0.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Features" Version="5.12.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.12.0" />
        <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
        <PackageVersion Include="NetTopologySuite.Features" Version="2.2.0" />

        <PackageVersion Include="NetTopologySuite.IO.GeoJSON4STJ" Version="4.0.0" />
        <PackageVersion Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
        <PackageVersion Include="NodaTime" Version="3.3.7" />
        <PackageVersion Include="NodaTime.Serialization.JsonNet" Version="3.3.0" />
        <PackageVersion Include="NodaTime.Testing" Version="3.3.7" />

        <PackageVersion Include="StronglyTypedId" Version="1.0.0-beta08" />
        <PackageVersion Include="Rocket.Surgery.Build.Information" Version="3.3.11" />
        <PackageVersion Include="Joinery.Dovetail.OpenTelemetry" Version="0.7.0" />
        <PackageVersion Include="Specular" Version="0.4.1" />
        <PackageVersion Include="Joinery.Dovetail" Version="0.7.0" />
        <PackageVersion Include="Joinery.Dovetail.DryIoc" Version="0.7.0" />
        <PackageVersion Include="Joinery.Dovetail.Hosting" Version="0.7.0" />
        <!-- binds and describes the configuration a project declares ([Optionary]); Dovetail 0.7.0 leaves the reference to the project -->
        <PackageVersion Include="Optionary" Version="0.1.1" />
        <!--
            No project references these: each LaunchPad SDK (src/Sdks) chains the Dovetail SDK of the same name at this version, which
            src/Sdks/Directory.Build.targets writes into its Sdk/Packages.props. Dovetail ships every package at one version.
        -->
        <PackageVersion Include="Joinery.Dovetail.Sdk" Version="0.7.0" />
        <PackageVersion Include="Joinery.Dovetail.Sdk.Console" Version="0.7.0" />
        <PackageVersion Include="Joinery.Dovetail.Sdk.Web" Version="0.7.0" />
        <PackageVersion Include="Joinery.Dovetail.Sdk.Worker" Version="0.7.0" />
        <PackageVersion Include="Joinery.Dovetail.Sdk.Razor" Version="0.7.0" />
        <PackageVersion Include="Joinery.Dovetail.Sdk.BlazorWebAssembly" Version="0.7.0" />
        <PackageVersion Include="Joinery.Dovetail.Sdk.WebAssembly" Version="0.7.0" />
        <PackageVersion Include="Joinery.Dovetail.Sdk.WindowsDesktop" Version="0.7.0" />
        <PackageVersion Include="Joinery.Dovetail.Sdk.Aspire.AppHost" Version="0.7.0" />
        <!--
            No project references it either: an MSBuild SDK from NuGet. test/Sdk.Tests compares Rocket.Surgery.LaunchPad.Sdk.Aspire.AppHost
            with Aspire.AppHost.Sdk at this version next to Rocket.Surgery.LaunchPad.Sdk; the version Joinery.Dovetail.Sdk.Aspire.AppHost
            0.7.0 imports.
        -->
        <PackageVersion Include="Aspire.AppHost.Sdk" Version="13.6.5" />
        <!-- the command line of sample/Sample.Command, the version Joinery.Dovetail.Sdk.Console adds to a console application -->
        <PackageVersion Include="ConsoleAppFramework" Version="5.8.1" />


        <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />

        <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
        <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
        <PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0" />
        <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
        <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageVersion Include="Serilog.Sinks.Observable" Version="3.0.0" />
        <PackageVersion Include="Serilog.Enrichers.Span" Version="3.1.0" />
        <PackageVersion Include="Swashbuckle.AspNetCore.ReDoc" Version="11.0.1" />
        <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
        <!--
            The runtimes of the clients Chirograph generates in the tests (test/Api/Functional/Clients/Api.Functional.HttpClient, the sample
            tests), at the versions Chirograph 0.1.0 was packed with. The projects reference them themselves: Chirograph's implicit
            references carry a version, which central package management rejects for a package that also has a PackageVersion (NU1009).
        -->
        <PackageVersion Include="Microsoft.Kiota.Bundle" Version="2.2.0" />
        <PackageVersion Include="Refit.HttpClientFactory" Version="17.0.0" />

        <PackageVersion Include="OpenTelemetry" Version="1.21.0" />

        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
        <PackageVersion Include="Alba" Version="9.0.0" />
        <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.TUnit" Version="11.0.1" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.SourceGenerators" Version="11.0.1" />
        <PackageVersion Include="TUnit" Version="1.86.6" />
        <PackageVersion Include="TUnit.Mocks" Version="1.86.6" />
        <!-- the Should syntax ships as a beta beside each TUnit release -->
        <PackageVersion Include="TUnit.Assertions.Should" Version="1.84.0-beta" />
        <PackageVersion Include="Verify.TUnit" Version="33.5.0" />
        <!-- test/Sdk.Tests writes its throwaway projects with it, as Dovetail's SDK tests do -->
        <PackageVersion Include="MSBuild.ProjectCreation" Version="20.0.0" />
        <PackageVersion Include="Verify.NodaTime" Version="2.3.0" />
        <PackageVersion Include="Verify.SystemJson" Version="2.1.0" />
        <PackageVersion Include="Verify.NewtonsoftJson" Version="1.1.0" />
        <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
  </ItemGroup>
    <!--
        The Microsoft packages that ship once per .NET release train, on the 11.0 line that goes with the SDK pinned in global.json.
        When LaunchPad targets two frameworks again, each framework gets its own group, conditioned with IsTargetFrameworkCompatible,
        never with an equality (CONTRIBUTING.md, "Adding a target framework").
    -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
        <PackageVersion Include="System.Net.Http.Json" Version="11.0.0" />
        <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    </ItemGroup>
</Project>
