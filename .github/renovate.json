{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>RocketSurgeonsGuild/.github:renovate-config"],
  "ignorePaths": ["**/node_modules/**", "**/*.csproj"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The .NET SDK pinned in mise (Renovate's mise manager does not update dotnet); comment lines may sit above it",
      "managerFilePatterns": ["/^\\.config/mise\\.toml$/"],
      "matchStrings": ["dotnet = \\[(?:\\s*#[^\\n]*)*\\s*\\{ version = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "dotnet-sdk",
      "datasourceTemplate": "dotnet-version",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Ship the .NET SDK (global.json and mise.toml) in the same PR as the NuGet packages",
      "matchDepNames": ["dotnet-sdk"],
      "groupName": "dotnet monorepo",
      "separateMinorPatch": false,
      "separateMultipleMinor": false
    },
    {
      "description": "The Aspire CLI pinned in mise resolves the AppHost build's bundle (ASPIRE009) and pairs with the Aspire.Hosting.* package version, so it moves in the same PR as them",
      "matchDepNames": ["Aspire.Cli"],
      "groupName": "aspire monorepo"
    },
    {
      "matchCategories": ["js"],
      "automerge": true,
      "labels": [":truck: private-dependencies"]
    },
    {
      "description": "Shipped: the src/Sdks LaunchPad SDKs chain Joinery.Dovetail.Sdk and pin it into their Packages.props; src/AspNetCore, Foundation and AspNetCore.Mvc use Specular. The org preset marks them private; this repository ships them",
      "matchDepNames": ["Joinery.Dovetail.Sdk", "Joinery.Dovetail.Sdk.*", "Specular"],
      "labels": [":package: dependencies"]
    },
    {
      "description": "Only the tests and samples use these (System.Reflection.Metadata only in the non-packable Foundation.Tasks): consumers of this repository's packages never get them",
      "matchDepNames": [
        "Alba",
        "Asp.Versioning.Http",
        "Asp.Versioning.Mvc",
        "ChannelMediator",
        "Foundatio.Mediator",
        "Foundatio.Mediator.Abstractions",
        "Immediate.Handlers",
        "Mediator.Abstractions",
        "Mediator.SourceGenerator",
        "Microsoft.Kiota.Bundle",
        "protobuf-net.Grpc.AspNetCore",
        "protobuf-net.Grpc.Reflection",
        "Refit.HttpClientFactory",
        "Refit.Reflection",
        "ZeroAlloc.Mapping",
        "Optionary",
        "Chirograph",
        "Riok.Mapperly",
        "Swashbuckle.AspNetCore",
        "Swashbuckle.AspNetCore.*",
        "ConsoleAppFramework",
        "Microsoft.Bcl.AsyncInterfaces",
        "System.Reflection.Metadata"
      ],
      "labels": [":truck: private-dependencies"]
    }
  ]
}
